---
// Layout for content pages and tools: the homepage design, nav and footer, with a dark title band,
// the page body, an optional FAQ, and the homepage's closing call to action.
import HomeLayout from './HomeLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { EMAIL, CHECK_PATH, HEADER_CTA_LABEL } from '../data/site';
import { monthYear, sameMonth } from '../data/reports';
import '../styles/content.css';

interface Props {
  title: string;
  description: string;
  h1: string;
  /** Short intro under the H1 */
  intro?: string;
  /** Breadcrumb trail after Home; the last item is this page */
  trail: { name: string; href?: string }[];
  /** Reports: ISO dates shown under the H1 as month and year. Updated only shows when its month differs from published. */
  dates?: { published?: string; modified?: string };
  faqs?: { q: string; a: string; link?: { text: string; href: string } }[];
  /** Closing call to action heading, if not the default */
  ctaTitle?: string;
  /** Hide the closing call to action (the AI Visibility Check page has its own) */
  hideCta?: boolean;
  /** Closing call to action: the free check, then the audit (instead of the email button) */
  ctaAudit?: boolean;
  /** Start every FAQ answer collapsed (default: the first one is open) */
  faqCollapsed?: boolean;
  jsonLd: object[];
}

const {
  title,
  description,
  h1,
  intro,
  trail,
  dates,
  faqs = [],
  ctaTitle = 'See where you stand in AI search.',
  hideCta = false,
  ctaAudit = false,
  faqCollapsed = false,
  jsonLd,
} = Astro.props;
const updated =
  dates?.modified && !(dates.published && sameMonth(dates.modified, dates.published)) ? dates.modified : undefined;
---

<HomeLayout {title} {description} {jsonLd}>
  <SiteNav />

  <main id="main">
    <section class="dark" aria-label="Introduction">
      <div class="wrap page-hero">
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            {
              trail.map((t) => (
                <li>{t.href ? <a href={t.href}>{t.name}</a> : <span aria-current="page">{t.name}</span>}</li>
              ))
            }
          </ol>
        </nav>
        <h1 class="page-hero__h1">{h1}</h1>
        {intro && <p class="hero__sub">{intro}</p>}
        <slot name="hero" />
        {
          (dates?.published || updated) && (
            <p class="page-hero__dates">
              {dates?.published && (
                <span>
                  Published <time datetime={dates.published}>{monthYear(dates.published)}</time>
                </span>
              )}
              {updated && (
                <span>
                  Updated <time datetime={updated}>{monthYear(updated)}</time>
                </span>
              )}
            </p>
          )
        }
      </div>
    </section>

    <slot />

    {
      faqs.length > 0 && (
        <section class="section section--sand" id="faq">
          <div class="wrap faq">
            <div class="faq__head">
              <p class="eyebrow">FAQ</p>
              <h2 class="h2 h2--36">Questions, answered.</h2>
            </div>
            <div class="faq__list">
              {faqs.map((f, i) => (
                <details open={!faqCollapsed && i === 0}>
                  <summary>{f.q}</summary>
                  <p>
                    {f.a}
                    {f.link && <a href={f.link.href}>{f.link.text}</a>}
                  </p>
                </details>
              ))}
            </div>
          </div>
        </section>
      )
    }

    {
      !hideCta && (
        <section class="dark cta">
          <div class="wrap cta__inner">
            <h2 class="h2 cta__title">{ctaTitle}</h2>
            <p class="cta__sub">
              Run the free AI Visibility Check. In about a minute you'll see whether ChatGPT recommends you, who it
              recommends instead, and what's holding you back.
              {ctaAudit && ' When you want the full picture for every product, start with the audit.'}
            </p>
            <div class="btn-row btn-row--center">
              <a href={CHECK_PATH} data-track="visibility_check" class="btn btn--accent">
                {HEADER_CTA_LABEL}
              </a>
              {ctaAudit ? (
                <a href="/pricing#audit" class="btn btn--ghost-dark">
                  See the audit
                </a>
              ) : (
                <a href={`mailto:${EMAIL}`} class="btn btn--ghost-dark">
                  Email me
                </a>
              )}
            </div>
          </div>
        </section>
      )
    }
  </main>

  <SiteFooter />
</HomeLayout>
