---
// Layout for content pages and tools: the homepage design, nav and footer, with a dark title band,
// the page body, an optional FAQ, and the homepage's closing call to action.
import HomeLayout from './HomeLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { EMAIL, CHECK_PATH, HEADER_CTA_LABEL } from '../data/site';
import { monthYear, sameMonth } from '../data/reports';
import '../styles/content.css';

interface Props {
  title: string;
  description: string;
  h1: string;
  /** Small red uppercase label above the H1, shown instead of the breadcrumb */
  eyebrow?: string;
  /** Hide the header's gap report button (pages for people who already paid) */
  hideNavCta?: boolean;
  /** Short intro under the H1 */
  intro?: string;
  /** Breadcrumb trail after Home; the last item is this page */
  trail: { name: string; href?: string }[];
  /** Reports, guides and comparison pages: ISO dates shown under the H1 as month and year, with the byline.
   *  Last updated always shows; Published shows only when its month differs. */
  dates?: { published?: string; modified?: string };
  faqs?: { q: string; a: string; link?: { text: string; href: string } }[];
  /** Closing call to action heading, if not the default */
  ctaTitle?: string;
  /** Hide the closing call to action (the AI Visibility Check page has its own) */
  hideCta?: boolean;
  /** Closing call to action: the check, then Close the Gap (instead of the email button) */
  ctaAudit?: boolean;
  /** Start every FAQ answer collapsed (default: the first one is open) */
  faqCollapsed?: boolean;
  jsonLd: object[];
}

const {
  title,
  description,
  h1,
  eyebrow,
  hideNavCta = false,
  intro,
  trail,
  dates,
  faqs = [],
  ctaTitle = 'See who AI recommends instead of you.',
  hideCta = false,
  ctaAudit = false,
  faqCollapsed = false,
  jsonLd,
} = Astro.props;
const updated = dates?.modified ?? dates?.published;
const published =
  dates?.published && updated && !sameMonth(updated, dates.published) ? dates.published : undefined;
---

<HomeLayout {title} {description} {jsonLd}>
  <SiteNav hideCta={hideNavCta} />

  <main id="main">
    <section class="dark" aria-label="Introduction">
      <div class="wrap page-hero">
        {eyebrow ? <p class="eyebrow">{eyebrow}</p> : (
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            {
              trail.map((t) => (
                <li>{t.href ? <a href={t.href}>{t.name}</a> : <span aria-current="page">{t.name}</span>}</li>
              ))
            }
          </ol>
        </nav>
        )}
        <h1 class="page-hero__h1">{h1}</h1>
        {intro && <p class="hero__sub">{intro}</p>}
        <slot name="hero" />
        {
          updated && (
            <p class="page-hero__dates">
              <span>
                By <a href="/about" rel="author">Carson Cobb</a>
              </span>
              {published && (
                <span>
                  Published <time datetime={published}>{monthYear(published)}</time>
                </span>
              )}
              <span>
                Last updated <time datetime={updated}>{monthYear(updated)}</time>
              </span>
            </p>
          )
        }
      </div>
    </section>

    <slot />

    {
      faqs.length > 0 && (
        <section class="section section--sand" id="faq">
          <div class="wrap faq">
            <div class="faq__head">
              <p class="eyebrow">FAQ</p>
              <h2 class="h2 h2--36">Questions, answered.</h2>
            </div>
            <div class="faq__list">
              {faqs.map((f, i) => (
                <details open={!faqCollapsed && i === 0}>
                  <summary>{f.q}</summary>
                  <p>
                    {f.a}
                    {f.link && <a href={f.link.href}>{f.link.text}</a>}
                  </p>
                </details>
              ))}
            </div>
          </div>
        </section>
      )
    }

    {
      !hideCta && (
        <section class="dark cta">
          <div class="wrap cta__inner">
            <h2 class="h2 cta__title">{ctaTitle}</h2>
            <p class="cta__sub">
              Get your gap report. It takes about a minute, no login, and shows how often ChatGPT recommends you against
              your top competitor. Brands doing $50K a month or more also get a short video of the full gap.
              {ctaAudit && ' When you want to close it across your top products and main competitors, see Close the Gap.'}
            </p>
            <div class="btn-row btn-row--center">
              <a href={CHECK_PATH} data-track="visibility_check" class="btn btn--accent">
                {HEADER_CTA_LABEL}
              </a>
              {ctaAudit ? (
                <a href="/close-the-gap" class="btn btn--ghost-dark">
                  See Close the Gap
                </a>
              ) : (
                <a href={`mailto:${EMAIL}`} class="btn btn--ghost-dark">
                  Email me
                </a>
              )}
            </div>
          </div>
        </section>
      )
    }
  </main>

  <SiteFooter />
</HomeLayout>
