---
// Layout for content pages and tools: the homepage design, nav and footer, with a dark title band,
// the page body, an optional FAQ, and the homepage's closing call to action.
import HomeLayout from './HomeLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { CAL_LINK, EMAIL } from '../data/site';
import { shortDate } from '../data/reports';
import '../styles/content.css';

interface Props {
  title: string;
  description: string;
  h1: string;
  /** Short intro under the H1 */
  intro?: string;
  /** Breadcrumb trail after Home; the last item is this page */
  trail: { name: string; href?: string }[];
  /** Reports: ISO dates shown under the H1. Updated only shows when it differs from published. */
  dates?: { published?: string; modified?: string };
  faqs?: { q: string; a: string }[];
  jsonLd: object[];
}

const { title, description, h1, intro, trail, dates, faqs = [], jsonLd } = Astro.props;
const updated = dates?.modified && dates.modified !== dates.published ? dates.modified : undefined;
---

<HomeLayout {title} {description} {jsonLd}>
  <SiteNav />

  <main id="main">
    <section class="dark" aria-label="Introduction">
      <div class="wrap page-hero">
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            {
              trail.map((t) => (
                <li>{t.href ? <a href={t.href}>{t.name}</a> : <span aria-current="page">{t.name}</span>}</li>
              ))
            }
          </ol>
        </nav>
        <h1 class="page-hero__h1">{h1}</h1>
        {intro && <p class="hero__sub">{intro}</p>}
        {
          (dates?.published || updated) && (
            <p class="page-hero__dates">
              {dates?.published && (
                <span>
                  Published <time datetime={dates.published}>{shortDate(dates.published)}</time>
                </span>
              )}
              {updated && (
                <span>
                  Updated <time datetime={updated}>{shortDate(updated)}</time>
                </span>
              )}
            </p>
          )
        }
      </div>
    </section>

    <slot />

    {
      faqs.length > 0 && (
        <section class="section section--sand" id="faq">
          <div class="wrap faq">
            <div class="faq__head">
              <p class="eyebrow">FAQ</p>
              <h2 class="h2 h2--36">Questions, answered.</h2>
            </div>
            <div class="faq__list">
              {faqs.map((f, i) => (
                <details open={i === 0}>
                  <summary>{f.q}</summary>
                  <p>{f.a}</p>
                </details>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <section class="dark cta">
      <div class="wrap cta__inner">
        <h2 class="h2 cta__title">Take the store off your plate.</h2>
        <p class="cta__sub">
          Book a 20 minute intro call. We'll look at where your store is losing money and the best place to start.
        </p>
        <div class="btn-row btn-row--center">
          <a href={CAL_LINK} data-track="book_call" target="_blank" rel="noopener" class="btn btn--accent">Book an intro call</a>
          <a href={`mailto:${EMAIL}`} class="btn btn--ghost-dark">Email me</a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</HomeLayout>
