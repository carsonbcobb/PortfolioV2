---
// One route per markdown page (src/content/pages and src/content/reports), at the slug in its frontmatter.
// Reports get their dates near the top, a Reports breadcrumb, and Article and Dataset JSON-LD.
import ContentPage from '../layouts/ContentPage.astro';
import { contentSchema, reportSchema } from '../data/schema';
import { pageBySlug } from '../data/pages';
import { MARKDOWN_PAGES, DESIGNED_PAGES, AI_RESEARCH, slugOf, isReportPage, isoDate, checkedDate, tableHeaders, type MarkdownPage } from '../data/reports';

export function getStaticPaths() {
  // Designed pages have their own route file and only borrow their markdown's frontmatter and sections.
  return MARKDOWN_PAGES.filter((page) => !DESIGNED_PAGES.includes(slugOf(page))).map((page) => ({
    params: { slug: slugOf(page) },
    props: { page },
  }));
}

const { page } = Astro.props as { page: MarkdownPage };
const fm = page.frontmatter;
const slug = slugOf(page);
const faqs = (fm.faq ?? []).map((f) => ({ q: f.question, a: f.answer }));
const report = isReportPage(page);

let trail: { name: string; href?: string }[];
let jsonLd: object[];
let dates: { published?: string; modified?: string } | undefined;

if (report) {
  const published = isoDate(fm.datePublished ?? fm.dateModified!);
  const modified = isoDate(fm.dateModified ?? published);
  dates = { published, modified };
  // AI search research: its own keywords, and a method line for reports built from ChatGPT chats.
  const ai = AI_RESEARCH.includes(page);
  const fromChats = ai && /temporary (ChatGPT )?chat/i.test(page.rawContent());
  trail = [{ name: 'Reports', href: '/reports' }, { name: fm.h1 }];
  jsonLd = [
    reportSchema({
      slug,
      title: fm.title,
      description: fm.description,
      h1: fm.h1,
      faqs,
      datePublished: published,
      dateModified: modified,
      checked: checkedDate(page),
      variables: tableHeaders(page),
      stores: fm.reportStores,
      products: fm.reportProducts,
      ...(ai ? { keywords: ['Shopify', 'ecommerce', 'AI search', 'ChatGPT', 'structured data'] } : {}),
      ...(fromChats ? { technique: 'Asking ChatGPT questions in temporary chats and recording every answer and source' } : {}),
    }),
  ];
} else {
  const info = pageBySlug(slug);
  trail = [{ name: info.label }];
  jsonLd = [
    contentSchema({ slug, title: fm.title, description: fm.description, label: info.label, faqs, service: info.service }),
  ];
}
---

<ContentPage title={fm.title} description={fm.description} h1={fm.h1} {trail} {dates} {faqs} {jsonLd}>
  <section class="section page-body">
    <div class="wrap">
      <article class="prose">
        <page.Content />
      </article>
    </div>
  </section>
</ContentPage>
