---
// One route per markdown page (src/content/pages and src/content/reports), at the slug in its frontmatter.
// Reports get their dates near the top, a Reports breadcrumb, and Article and Dataset JSON-LD.
import ContentPage from '../layouts/ContentPage.astro';
import { contentSchema, reportSchema } from '../data/schema';
import { pageBySlug, CONTENT_PAGES } from '../data/pages';
import { MARKDOWN_PAGES, DESIGNED_PAGES, AI_RESEARCH, ROUNDUPS, slugOf, isReportPage, isoDate, checkedDate, coverage, tableHeaders, type MarkdownPage } from '../data/reports';

export function getStaticPaths() {
  // Designed pages have their own route file and only borrow their markdown's frontmatter and sections.
  return MARKDOWN_PAGES.filter((page) => !DESIGNED_PAGES.includes(slugOf(page))).map((page) => ({
    params: { slug: slugOf(page) },
    props: { page },
  }));
}

const { page } = Astro.props as { page: MarkdownPage };
const fm = page.frontmatter;
const slug = slugOf(page);
const faqs = (fm.faq ?? []).map((f) => ({ q: f.question, a: f.answer }));
const report = isReportPage(page);

let trail: { name: string; href?: string }[];
// Every report links to the service page its findings support: AI search research to /ai-search,
// store research to /shopify-conversion-optimization, unless the report already links a service page.
let related: { href: string; label: string } | undefined;
let jsonLd: object[];
let dates: { published?: string; modified?: string } | undefined;

if (report) {
  const published = isoDate(fm.datePublished ?? fm.dateModified!);
  const modified = isoDate(fm.dateModified ?? published);
  dates = { published, modified };
  // AI search research: its own keywords, and a method line for reports built from AI chats.
  const ai = AI_RESEARCH.includes(page);
  const raw = page.rawContent();
  const fromChats = ai && /temporary (ChatGPT )?chat|new thread/i.test(raw);
  // The AI tools named in the method section, so the Dataset says which ones were asked.
  const method = raw.split(/^## How this was done\s*$/m)[1]?.split(/^## /m)[0] ?? raw;
  const tools = [['ChatGPT', /ChatGPT/], ['Gemini', /Gemini/], ['Google AI Mode', /AI Mode/]]
    .filter(([, re]) => (re as RegExp).test(method))
    .map(([name]) => name as string);
  const toolList = tools.length > 1 ? `${tools.slice(0, -1).join(', ')} and ${tools.at(-1)}` : (tools[0] ?? 'ChatGPT');
  const technique =
    tools.length > 1 || !tools.includes('ChatGPT')
      ? `Asking ${toolList} buyer questions in new chats and recording every answer and source`
      : 'Asking ChatGPT questions in temporary chats and recording every answer and source';
  trail = [{ name: 'Reports', href: '/reports' }, { name: fm.h1 }];
  const services = CONTENT_PAGES.filter((p) => p.kind === 'service');
  const linksService = services.some((p) => page.rawContent().includes(`](/${p.slug})`));
  if (!linksService) {
    const target = services.find((p) => p.slug === (ai ? 'ai-search' : 'shopify-conversion-optimization'))!;
    related = { href: `/${target.slug}`, label: target.service!.name };
  }
  jsonLd = [
    reportSchema({
      slug,
      title: fm.title,
      description: fm.description,
      h1: fm.h1,
      faqs,
      datePublished: published,
      dateModified: modified,
      checked: checkedDate(page),
      coverage: coverage(page),
      dataset: !ROUNDUPS.includes(slug),
      variables: tableHeaders(page),
      stores: fm.reportStores,
      products: fm.reportProducts,
      ...(ai ? { keywords: ['Shopify', 'ecommerce', 'AI search', 'ChatGPT', 'structured data'] } : {}),
      ...(fromChats ? { technique } : {}),
    }),
  ];
} else {
  const info = pageBySlug(slug);
  trail = [{ name: info.label }];
  jsonLd = [
    contentSchema({ slug, title: fm.title, description: fm.description, label: info.label, faqs, service: info.service }),
  ];
}
---

<ContentPage title={fm.title} description={fm.description} h1={fm.h1} {trail} {dates} {faqs} {jsonLd}>
  <section class="section page-body">
    <div class="wrap">
      <article class="prose">
        <page.Content />
        {
          related && (
            <p class="report-related">
              Related service: <a href={related.href}>{related.label}</a>
            </p>
          )
        }
      </article>
    </div>
  </section>
</ContentPage>
