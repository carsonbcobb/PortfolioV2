---
// One route per markdown page (src/content/pages and src/content/reports), at the slug in its frontmatter.
// Reports get their dates near the top, a Reports breadcrumb, and Article and Dataset JSON-LD.
import ContentPage from '../layouts/ContentPage.astro';
import PriceSummary from '../components/PriceSummary.astro';
import ReportCta from '../components/ReportCta.astro';
import { contentSchema, reportSchema } from '../data/schema';
import { pageBySlug, CONTENT_PAGES } from '../data/pages';
import { MARKDOWN_PAGES, DESIGNED_PAGES, AI_RESEARCH, ROUNDUPS, slugOf, isReportPage, isoDate, checkedDate, coverage, tableHeaders, standardLinks, type MarkdownPage } from '../data/reports';

export function getStaticPaths() {
  // Designed pages have their own route file and only borrow their markdown's frontmatter and sections.
  return MARKDOWN_PAGES.filter((page) => !DESIGNED_PAGES.includes(slugOf(page))).map((page) => ({
    params: { slug: slugOf(page) },
    props: { page },
  }));
}

const { page } = Astro.props as { page: MarkdownPage };
const fm = page.frontmatter;
const slug = slugOf(page);
const faqs = (fm.faq ?? []).map((f) => ({ q: f.question, a: f.answer, link: f.link }));
const report = isReportPage(page);

let trail: { name: string; href?: string }[];
// Every report links to the service page its findings support: AI search research to /ai-search,
// store research to /shopify-conversion-optimization, unless the report already links a service page.
let related: { href: string; label: string; lead: string } | undefined;
let jsonLd: object[];
let dates: { published?: string; modified?: string } | undefined;
// Reports and guides: the /ai-search and competitor guide lines the copy is missing.
const standard = report || pageBySlug(slug).kind === 'guide' ? standardLinks(page) : [];
// Industry pages: the pricing cards after the body, and a closing call to action that ends on the audit.
const industry = !report && pageBySlug(slug).kind === 'industry';

// Reports: the markdown with the two ReportCta cards in the slots rehypeReportCtaSlots marked.
const SLOTS = /<div data-cta-slot="(short_version|end)"><\/div>/;
let reportParts: string[] | undefined;
if (report) {
  const parts = (await page.compiledContent()).split(SLOTS);
  // [before, "short_version" | "end", middle, "short_version" | "end", after]
  if (parts.length !== 5 || parts[1] !== 'short_version' || parts[3] !== 'end')
    throw new Error(`/${slug} needs one short_version slot before one end slot for its CTA`);
  reportParts = [parts[0], parts[2], parts[4]];
}
// Pages and guides: one ReportCta card where the markdown marks <div data-cta-slot="page"></div>.
const PAGE_SLOT = '<div data-cta-slot="page"></div>';
let pageParts: string[] | undefined;
if (!report && fm.pageCta) {
  pageParts = (await page.compiledContent()).split(PAGE_SLOT);
  if (pageParts.length !== 2) throw new Error(`/${slug} has pageCta, so it needs one ${PAGE_SLOT} in its markdown`);
}
const ctaSlug = slug.replace(/^reports\//, '');
const ctaVariant = fm.cta === 'cro' ? 'cro' : 'ai';

if (report) {
  const published = isoDate(fm.datePublished ?? fm.dateModified!);
  const modified = isoDate(fm.dateModified ?? published);
  dates = { published, modified };
  // AI search research: its own keywords, and a method line for reports built from AI chats.
  const ai = AI_RESEARCH.includes(page);
  const raw = page.rawContent();
  // The AI tools named in the method section, so the Dataset says which ones were asked.
  // The Limits line can name tools that weren't asked ("Gemini ... weren't included"), so it's left out.
  const method = (raw.split(/^## How this was done\s*$/m)[1]?.split(/^## /m)[0] ?? raw).replace(/^- \*\*Limits:\*\*.*$/m, '');
  const tools = [['ChatGPT', /ChatGPT/], ['Gemini', /Gemini/], ['Google AI Mode', /AI Mode/]]
    .filter(([, re]) => (re as RegExp).test(method))
    .map(([name]) => name as string);
  // Built from AI chats: the copy says how the chats were run, or the method asks shopping questions in an AI.
  const chatsNamed = /temporary (ChatGPT )?chat|new thread|fresh session/i.test(raw);
  const asksQuestions = /(shopping|buyer) questions/i.test(method) && tools.length > 0;
  const fromChats = ai && (chatsNamed || asksQuestions);
  // Store scans that also compare against AI answers: both methods.
  const alsoStores = fromChats && !chatsNamed && !!fm.reportStores;
  // Reports that compare Google's results with AI Mode, rather than asking AI tools in chats.
  const vsGoogle = ai && /in Google search and in Google AI Mode/.test(method);
  const toolList = tools.length > 1 ? `${tools.slice(0, -1).join(', ')} and ${tools.at(-1)}` : (tools[0] ?? 'ChatGPT');
  const technique =
    tools.length > 1 || !tools.includes('ChatGPT')
      ? `Asking ${toolList} buyer questions in new chats and recording every answer and source`
      : /temporary (ChatGPT )?chat/i.test(raw)
        ? 'Asking ChatGPT questions in temporary chats and recording every answer and source'
        : 'Asking ChatGPT buyer questions in new chats and recording every answer and source';
  trail = [{ name: 'Reports', href: '/reports' }, { name: fm.h1 }];
  const services = CONTENT_PAGES.filter((p) => p.kind === 'service');
  const linksService = services.some((p) => page.rawContent().includes(`](/${p.slug})`));
  // AI research gets its /ai-search line from standardLinks, so this covers store research only.
  if (!linksService && !ai) {
    const target = services.find((p) => p.slug === 'shopify-conversion-optimization')!;
    // A sentence, not a label, so every report links its service page in the body copy.
    const lead = ai
      ? 'To get your own products recommended by AI, see my'
      : 'To turn findings like these into sales on your own store, see my';
    related = { href: `/${target.slug}`, label: ai ? 'AI search optimization' : 'conversion optimization', lead };
  }
  jsonLd = [
    reportSchema({
      slug,
      title: fm.title,
      description: fm.description,
      h1: fm.h1,
      faqs,
      datePublished: published,
      dateModified: modified,
      checked: checkedDate(page),
      coverage: coverage(page),
      dataset: !ROUNDUPS.includes(slug),
      us: /\bUS (Shopify stores|brands)\b/.test(raw),
      variables: tableHeaders(page),
      stores: fm.reportStores,
      products: fm.reportProducts,
      ...(vsGoogle
        ? {
            keywords: ['Shopify', 'ecommerce', 'AI search', 'Google AI Mode', 'Google Search'],
            technique: 'Running buyer questions in Google Search and Google AI Mode and comparing the sites each one showed',
          }
        : {
            ...(ai ? { keywords: ['Shopify', 'ecommerce', 'AI search', 'ChatGPT', 'structured data'] } : {}),
            ...(fromChats
              ? {
                  technique: alsoStores
                    ? `Reading each store's public Shopify storefront data, and ${technique[0].toLowerCase()}${technique.slice(1)}`
                    : technique,
                }
              : {}),
          }),
    }),
  ];
} else {
  const info = pageBySlug(slug);
  trail = [{ name: info.label }];
  // Comparison guides show their dates under the H1, matching the Article dates.
  if (info.kind === 'guide' && fm.dateModified)
    dates = { published: isoDate(fm.datePublished ?? fm.dateModified), modified: isoDate(fm.dateModified) };
  jsonLd = [
    contentSchema({
      slug,
      title: fm.title,
      description: fm.description,
      label: info.label,
      faqs,
      service: info.service,
      // Comparison guides with dates in their frontmatter are Articles by Carson.
      ...(info.kind === 'guide' && fm.dateModified
        ? {
            article: {
              headline: fm.h1,
              datePublished: isoDate(fm.datePublished ?? fm.dateModified),
              dateModified: isoDate(fm.dateModified),
            },
          }
        : {}),
    }),
  ];
}
---

<ContentPage title={fm.title} description={fm.description} h1={fm.h1} intro={fm.answer} {trail} {dates} {faqs} {jsonLd} ctaAudit={industry}>
  <section class="section page-body">
    <div class="wrap">
      <article class="prose">
        {
          reportParts ? (
            <>
              <Fragment set:html={reportParts[0]} />
              <ReportCta variant={ctaVariant} size="compact" slug={ctaSlug} position="short_version" />
              <Fragment set:html={reportParts[1]} />
              <ReportCta variant={ctaVariant} size="full" slug={ctaSlug} position="end" />
              <Fragment set:html={reportParts[2]} />
            </>
          ) : pageParts ? (
            <>
              <Fragment set:html={pageParts[0]} />
              <ReportCta variant={fm.pageCta!.variant ?? 'ai'} headline={fm.pageCta!.headline} body={fm.pageCta!.body} slug={slug} from={slug} position="page" />
              <Fragment set:html={pageParts[1]} />
            </>
          ) : (
            <page.Content />
          )
        }
        {
          related && (
            <p class="report-related">
              {related.lead} <a href={related.href}>{related.label}</a> work.
            </p>
          )
        }
        {standard.map((l) => (
          <p class="report-related">
            {l.lead} <a href={l.href}>{l.label}</a>{l.tail}
          </p>
        ))}
      </article>
    </div>
  </section>
  {industry && <PriceSummary id="work-together" eyebrow="Working together" heading="How we work together" brief />}
</ContentPage>
