---
import HomeLayout from '../layouts/HomeLayout.astro';
import '../styles/agencies.css';
import {
  CAL_LINK,
  LINKEDIN_URL,
  EMAIL,
  AGENCY_EMAIL_URL,
  AGENCY_TICKET_STATS,
  AGENCY_TICKETS,
  AGENCY_STATS,
  AGENCY_PAINS,
  AGENCY_SCOPE,
  AGENCY_PLANS,
  AGENCY_CLIENT_PLANS,
  AGENCY_STEPS,
  AGENCY_PROMISE,
  AGENCY_FAQS,
} from '../data/site';
import { agenciesSchema } from '../data/schema';

const usd = (n: number) => `$${n.toLocaleString('en-US')}`;

// Every booking button goes to CAL_LINK and is tracked as a book_call event.
const book = {
  href: CAL_LINK,
  'data-track': 'book_call',
  ...(CAL_LINK.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {}),
};

const year = new Date().getFullYear();

const description =
  'A senior Shopify developer and ecommerce lead you can put on any account. Behind the scenes in your tools, or on calls with your clients as part of your team. You keep the relationship and the margin.';

const title = 'White Label Shopify Developer for Agencies | Carson Cobb';
const heroSub =
  'I own client stores end to end, from strategy and CRO to the build, and join calls as part of your team. No specs, no QA, no hand holding. You sell bigger retainers without hiring senior talent.';

const jsonLd = [agenciesSchema({ title, description })];
---

<HomeLayout
  {title}
  description={description}
  keywords="white label Shopify developer, Shopify developer for agencies, Shopify dev capacity, Shopify development"
  jsonLd={jsonLd}
  ogImage={{ path: '/og-image-agencies.png', alt: 'Carson Cobb, white label Shopify development for agencies' }}
>
  <header class="dark">
    <nav class="wrap nav" aria-label="Main">
      <a href="/" class="nav__brand">Carson Cobb</a>
      <div class="nav__links">
        <a href="/">For brands</a>
        <a href="#scope">What I take on</a>
        <a href="#pricing">Pricing</a>
        <a href="#faq">FAQ</a>
        <a {...book} class="btn btn--accent nav__cta">Book a call</a>
      </div>
    </nav>
  </header>

  <main id="main">
    <!-- Hero -->
    <section class="dark" aria-label="Introduction">
      <div class="wrap hero">
        <div class="hero__text">
          <div class="hero__pill">
            <span class="dot" aria-hidden="true"></span>
            White label Shopify partner for agencies
          </div>
          <h1 class="hero__h1">A senior Shopify lead for your clients. <span class="accent">Under your name.</span></h1>
          <p class="hero__sub">{heroSub}</p>
          <div class="btn-row">
            <a {...book} class="btn btn--accent"
              >Book an intro call
              <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
            </a>
            <a href="#pricing" class="btn btn--ghost-dark">See pricing</a>
          </div>
          <p class="hero__fine">
            <strong>50+ Shopify stores, from startups to ten figure brands.</strong> Already working white label for agency
            partners.
          </p>
        </div>

        <div class="hero__panel">
          <div class="tickets">
            <div class="tickets__head">
              <div class="tickets__title">
                <span class="tag tag--dim">Your agency · This month</span>
                <span class="tickets__count">12 tickets shipped this month</span>
              </div>
              <span class="tickets__example">Example</span>
            </div>
            <div class="tickets__stats">
              {
                AGENCY_TICKET_STATS.map((s) => (
                  <div class="tickets__stat">
                    <div class="tickets__stat-label">{s.label}</div>
                    <div class="tickets__stat-value">{s.value}</div>
                  </div>
                ))
              }
            </div>
            <div class="tickets__list">
              {
                AGENCY_TICKETS.map((t) => (
                  <div class="ticket">
                    <div class="ticket__text">
                      <span class="tag tag--dim ticket__client">{t.client}</span>
                      <span class="ticket__title">{t.title}</span>
                    </div>
                    <div class="ticket__meta">
                      <span class="ticket__hours">{t.hours}</span>
                      <span class={`ticket__status ticket__status--${t.status}`}>{t.label}</span>
                    </div>
                  </div>
                ))
              }
            </div>
            <div class="tickets__hours">
              <div class="tickets__hours-row">
                <span>Reserved hours used</span>
                <span class="tickets__hours-used">24 of 32</span>
              </div>
              <div class="tickets__bar" aria-hidden="true"><div class="tickets__bar-fill"></div></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Proof strip -->
    <section class="proof" aria-label="At a glance">
      <div class="wrap proof__inner">
        <div class="proof__stats">
          {
            AGENCY_STATS.map((s) => (
              <div>
                <div class="proof__value">{s.value}</div>
                <div class="proof__label">{s.label}</div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- The problem -->
    <section class="section">
      <div class="wrap stack">
        <div class="head">
          <p class="eyebrow">The problem</p>
          <h2 class="h2">Your growth is capped by senior talent, not demand.</h2>
          <p class="lede">
            Junior and offshore developers can follow a spec. What's hard to find is someone who can run an account:
            decide what to build, build it right the first time, and talk to the client like a partner. Without that
            person, you turn down bigger clients or stretch your best people thin.
          </p>
        </div>
        <div class="grid grid--300">
          {
            AGENCY_PAINS.map((p) => (
              <div class="card pain">
                <span class="tag">{p.tag}</span>
                <h3 class="pain__title">{p.title}</h3>
                <p class="pain__text">{p.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- What I take on -->
    <section id="scope" class="section section--sand">
      <div class="wrap stack">
        <div class="head head--split">
          <div class="head">
            <p class="eyebrow">What I take on</p>
            <h2 class="h2">The accounts and builds that need a senior lead.</h2>
          </div>
          <p class="lede head__aside">Strategy, complex builds, and client facing work, delivered as your team.</p>
        </div>
        <div class="grid grid--320">
          {
            AGENCY_SCOPE.map((s) => (
              <div class="card own">
                <svg aria-hidden="true" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#C8323A" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={s.icon} />
                <h3 class="own__title">{s.title}</h3>
                <p class="own__text">{s.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Pricing -->
    <section id="pricing" class="section">
      <div class="wrap stack">
        <div class="head">
          <p class="eyebrow">Pricing</p>
          <h2 class="h2">Simple rates. Your markup.</h2>
          <p class="lede">
            Buy a block, send tickets, and bill your client whatever you like. No retainers you don't need, no surprise
            invoices.
          </p>
        </div>

        <div class="plans__group">
          <div class="plans__group-head">
            <h3 class="h3">Senior hours on demand</h3>
            <p class="plans__intro">Senior Shopify work across any client, billed on tracked time.</p>
          </div>
          <div class="grid grid--320 plans plans--agency">
            {
              AGENCY_PLANS.map((p) => (
                <div class:list={['card', 'plan', { 'plan--featured': p.featured }]}>
                  {p.featured && <span class="plan__badge">PRIORITY</span>}
                  <div class="plan__head">
                    <span class:list={['tag', { 'tag--dim': p.featured }]}>{p.tag}</span>
                    <h3 class="h3">{p.name}</h3>
                    <div class="plan__price">
                      {usd(p.price)}
                      <span>{p.unit}</span>
                    </div>
                    <p class="plan__summary">{p.summary}</p>
                  </div>
                  <ul class="plan__list">
                    {p.includes.map((i) => (
                      <li>
                        <span aria-hidden="true">✓</span>
                        {i}
                      </li>
                    ))}
                  </ul>
                  <div class="plan__foot">
                    <a {...book} class:list={['btn', p.featured ? 'btn--accent' : 'btn--outline']}>
                      Book a call
                    </a>
                  </div>
                </div>
              ))
            }
          </div>
          <p class="lock__terms plans__note">One-off requests without a block are $125/hr with a one hour minimum.</p>
        </div>

        <div class="plans__group">
          <div class="plans__group-head">
            <h3 class="h3">White label plans for your clients</h3>
            <p class="plans__intro">
              A senior lead who owns one client store under your name. Priced per store. You set the markup.
            </p>
          </div>
          <div class="grid plans plans--client">
            {
              AGENCY_CLIENT_PLANS.map((p) => (
                <div class="card plan">
                  <div class="plan__head">
                    <span class="tag">{p.tag}</span>
                    <h3 class="h3">{p.name}</h3>
                    <div class="plan__price">
                      {usd(p.price)}
                      <span>{p.unit}</span>
                    </div>
                    <p class="plan__summary">{p.summary}</p>
                  </div>
                  <ul class="plan__list">
                    {p.includes.map((i) => (
                      <li>
                        <span aria-hidden="true">✓</span>
                        {i}
                      </li>
                    ))}
                  </ul>
                  <div class="plan__foot">
                    <a {...book} class="btn btn--outline">
                      Book a call
                    </a>
                  </div>
                </div>
              ))
            }
          </div>
          <p class="lock__terms plans__note">
            Extra hours on any plan are $125/hr. 30 days notice to cancel monthly plans.
          </p>
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section class="section section--flush">
      <div class="wrap stack">
        <div class="head">
          <p class="eyebrow">How it works</p>
          <h2 class="h2">Extra capacity this week, not next quarter.</h2>
        </div>
        <div class="grid grid--300">
          {
            AGENCY_STEPS.map((s) => (
              <div class="step">
                <span class="tag tag--accent">{s.when}</span>
                <h3 class="step__title">{s.title}</h3>
                <p class="step__text">{s.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- White label promise -->
    <section class="section section--flush">
      <div class="wrap">
        <div class="promise">
          <div class="promise__text">
            <p class="eyebrow promise__eyebrow">Your client, always</p>
            <h2 class="h2 promise__title">Your clients stay your clients.</h2>
            <p class="promise__sub">
              I'm an extension of your team, not a competitor. Front and center or fully behind the scenes, the
              relationship is always yours.
            </p>
          </div>
          <ul class="promise__list">
            {
              AGENCY_PROMISE.map((p) => (
                <li>
                  <span aria-hidden="true">✓</span>
                  {p}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="section section--flush">
      <div class="wrap faq">
        <div class="faq__head">
          <p class="eyebrow">FAQ</p>
          <h2 class="h2 h2--36">Questions, answered.</h2>
        </div>
        <div class="faq__list">
          {
            AGENCY_FAQS.map((f, i) => (
              <details open={i === 0}>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section id="book" class="dark cta">
      <div class="wrap cta__inner">
        <h2 class="h2 cta__title">Say yes to bigger clients.</h2>
        <p class="cta__sub">Book a 20 minute call and we'll talk through the accounts you'd hand me first.</p>
        <div class="btn-row btn-row--center">
          <a {...book} class="btn btn--accent">Book an intro call</a>
          <a href={AGENCY_EMAIL_URL} class="btn btn--ghost-dark">Email me</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="dark footer">
    <div class="wrap footer__inner">
      <span>
        © {year} Carson Cobb · <a href={`mailto:${EMAIL}`}>{EMAIL}</a> · <a href={LINKEDIN_URL}>LinkedIn</a>
      </span>
      <span>Shopify is a trademark of Shopify Inc. Independent contractor, not affiliated with Shopify.</span>
    </div>
  </footer>
</HomeLayout>
