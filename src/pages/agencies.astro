---
import HomeLayout from '../layouts/HomeLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/agencies.css';
import {
  CAL_LINK,
  EMAIL,
  AGENCY_EMAIL_URL,
  AGENCY_TICKET_STATS,
  AGENCY_TICKETS,
  AGENCY_STATS,
  AGENCY_PAINS,
  AGENCY_SCOPE,
  AGENCY_PARTNER_INTRO,
  AGENCY_PARTNER_PLANS,
  AGENCY_STEPS,
  AGENCY_PROMISE,
  AGENCY_FAQS,
} from '../data/site';
import { agenciesSchema } from '../data/schema';

// Every booking button goes to CAL_LINK and is tracked as a book_call event.
const book = {
  href: CAL_LINK,
  'data-track': 'book_call',
  ...(CAL_LINK.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {}),
};

const description =
  'White label AI search and CRO for agencies with Shopify clients. You sell it, I implement it under your name: audits, structured data and conversion work.';

const title = 'AI Search and CRO Partner for Agencies | Carson Cobb';
const heroSub =
  'You sell AI search and conversion work to your Shopify clients. I implement it under your name: AI visibility audits, product data, product pages that answer buyer questions, and conversion testing. You keep the relationship and the margin.';

const jsonLd = [agenciesSchema({ title, description })];
---

<HomeLayout
  {title}
  description={description}
  keywords="white label AI search, AEO for agencies, white label CRO, Shopify AI search partner, white label Shopify"
  jsonLd={jsonLd}
  ogImage={{ path: '/og-image-agencies.png', alt: 'Carson Cobb, white label AI search and CRO for agencies' }}
>
  <SiteNav />

  <main id="main">
    <!-- Hero -->
    <section class="dark" aria-label="Introduction">
      <div class="wrap hero">
        <div class="hero__text">
          <div class="hero__pill">
            <span class="dot" aria-hidden="true"></span>
            AI search and CRO implementation partner
          </div>
          <h1 class="hero__h1">AI search and CRO for your clients. <span class="accent">Under your name.</span></h1>
          <p class="hero__sub">{heroSub}</p>
          <div class="btn-row">
            <a {...book} class="btn btn--accent"
              >Book an intro call
              <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
            </a>
            <a href="#pricing" class="btn btn--ghost-dark">See pricing</a>
          </div>
          <p class="hero__fine">
            <strong>50+ AI search audits. 30+ sites optimized for AI search. 50+ Shopify stores, from startups to billion dollar brands.</strong>
            Already working white label for agency partners.
          </p>
        </div>

        <div class="hero__panel">
          <div class="tickets">
            <div class="tickets__head">
              <div class="tickets__title">
                <span class="tag tag--dim">Your agency · This month</span>
                <span class="tickets__count">12 tickets shipped this month</span>
              </div>
              <span class="tickets__example">Example</span>
            </div>
            <div class="tickets__stats">
              {
                AGENCY_TICKET_STATS.map((s) => (
                  <div class="tickets__stat">
                    <div class="tickets__stat-label">{s.label}</div>
                    <div class="tickets__stat-value">{s.value}</div>
                  </div>
                ))
              }
            </div>
            <div class="tickets__list">
              {
                AGENCY_TICKETS.map((t) => (
                  <div class="ticket">
                    <div class="ticket__text">
                      <span class="tag tag--dim ticket__client">{t.client}</span>
                      <span class="ticket__title">{t.title}</span>
                    </div>
                    <div class="ticket__meta">
                      <span class={`ticket__status ticket__status--${t.status}`}>{t.label}</span>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Proof strip -->
    <section class="proof" aria-label="At a glance">
      <div class="wrap proof__inner">
        <div class="proof__stats">
          {
            AGENCY_STATS.map((s) => (
              <div>
                <div class="proof__value">{s.value}</div>
                <div class="proof__label">{s.label}</div>
              </div>
            ))
          }
        </div>
        <p class="fineprint report-link">Want proof before you put me on an account? <a href="/results">See the results.</a></p>
      </div>
    </section>

    <!-- The problem -->
    <section class="section">
      <div class="wrap stack">
        <div class="head">
          <p class="eyebrow">The problem</p>
          <h2 class="h2">Your clients are asking about AI search.</h2>
          <p class="lede">
            Shoppers now ask ChatGPT what to buy, and your clients want to know why a competitor shows up and they don't.
            Most agencies don't have someone who can answer that, let alone fix it, and convert the traffic once it
            arrives. Without that person, you turn the work down or learn on a client's account.
          </p>
        </div>
        <div class="grid grid--300">
          {
            AGENCY_PAINS.map((p) => (
              <div class="card pain">
                <span class="tag">{p.tag}</span>
                <h3 class="pain__title">{p.title}</h3>
                <p class="pain__text">{p.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- What I take on -->
    <section id="scope" class="section section--sand">
      <div class="wrap stack">
        <div class="head head--split">
          <div class="head">
            <p class="eyebrow">What I take on</p>
            <h2 class="h2">AI search and CRO work, delivered as your team.</h2>
          </div>
          <p class="lede head__aside">Audits, implementation and reporting, under your brand and in your tools.</p>
        </div>
        <div class="grid grid--320">
          {
            AGENCY_SCOPE.map((s) => (
              <div class="card own">
                <svg aria-hidden="true" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#C8323A" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={s.icon} />
                <h3 class="own__title">{s.title}</h3>
                <p class="own__text">{s.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Pricing -->
    <section id="pricing" class="section">
      <div class="wrap stack">
        <div class="head">
          <p class="eyebrow">Pricing</p>
          <h2 class="h2">Partner pricing.</h2>
          <p class="lede">{AGENCY_PARTNER_INTRO}</p>
        </div>
        <div class="grid grid--320 plans plans--agency">
          {
            AGENCY_PARTNER_PLANS.map((p) => (
              <div class:list={['card', 'plan', { 'plan--featured': p.featured }]}>
                <div class="plan__head">
                  <span class:list={['tag', { 'tag--dim': p.featured }]}>{p.tag}</span>
                  <h3 class="h3">{p.name}</h3>
                  <p class="plan__summary">{p.summary}</p>
                </div>
                <ul class="plan__list">
                  {p.includes.map((i) => (
                    <li>
                      <span aria-hidden="true">✓</span>
                      {i}
                    </li>
                  ))}
                </ul>
                <div class="plan__foot">
                  <a {...book} class:list={['btn', p.featured ? 'btn--accent' : 'btn--outline']}>
                    Book a call
                  </a>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section class="section section--flush">
      <div class="wrap stack">
        <div class="head">
          <p class="eyebrow">How it works</p>
          <h2 class="h2">Sell AI search this week, not next quarter.</h2>
        </div>
        <div class="grid grid--300">
          {
            AGENCY_STEPS.map((s) => (
              <div class="step">
                <span class="tag tag--accent">{s.when}</span>
                <h3 class="step__title">{s.title}</h3>
                <p class="step__text">{s.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- White label promise -->
    <section class="section section--flush">
      <div class="wrap">
        <div class="promise">
          <div class="promise__text">
            <p class="eyebrow promise__eyebrow">Your client, always</p>
            <h2 class="h2 promise__title">Your clients stay your clients.</h2>
            <p class="promise__sub">
              I'm an extension of your team, not a competitor. Front and center or fully behind the scenes, the
              relationship is always yours.
            </p>
          </div>
          <ul class="promise__list">
            {
              AGENCY_PROMISE.map((p) => (
                <li>
                  <span aria-hidden="true">✓</span>
                  {p}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="section section--flush">
      <div class="wrap faq">
        <div class="faq__head">
          <p class="eyebrow">FAQ</p>
          <h2 class="h2 h2--36">Questions, answered.</h2>
        </div>
        <div class="faq__list">
          {
            AGENCY_FAQS.map((f, i) => (
              <details open={i === 0}>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section id="book" class="dark cta">
      <div class="wrap cta__inner">
        <h2 class="h2 cta__title">Sell AI search and CRO without hiring for it.</h2>
        <p class="cta__sub">Book a 20 minute call and we'll talk through the client accounts you'd hand me first.</p>
        <div class="btn-row btn-row--center">
          <a {...book} class="btn btn--accent">Book an intro call</a>
          <a href={AGENCY_EMAIL_URL} class="btn btn--ghost-dark">Email me</a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</HomeLayout>
