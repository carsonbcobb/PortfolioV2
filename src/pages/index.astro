---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import Button from '../components/Button.astro';
import ContactCta from '../components/ContactCta.astro';
import {
  CAL_LINK,
  SITE_URL,
  LINKEDIN_URL,
  EMAIL,
  HEADSHOT,
  STATS,
  VERTICALS,
  DISCLAIMER,
  PLANS,
  PLAN_TERMS,
  SPRINT,
  RESULTS_NOTE,
  CASE_STUDIES,
  TESTIMONIALS,
  RECENT_WORK,
  PROBLEMS,
  PROCESS,
  WHY_ME,
  FAQS,
} from '../data/site';

const usd = (n: number) => `$${n.toLocaleString('en-US')}`;

const person = {
  '@type': 'Person',
  '@id': `${SITE_URL}/#carson`,
  name: 'Carson Cobb',
  jobTitle: 'Shopify Store Operator',
  url: SITE_URL,
  email: `mailto:${EMAIL}`,
  sameAs: [LINKEDIN_URL],
  address: { '@type': 'PostalAddress', addressRegion: 'CA', addressCountry: 'US' },
};

const jsonLd = [
  { '@context': 'https://schema.org', ...person },
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    '@id': `${SITE_URL}/#service`,
    name: 'Carson Cobb, Shopify Store Operator',
    url: SITE_URL,
    image: `${SITE_URL}/og-image.png`,
    email: EMAIL,
    founder: { '@id': `${SITE_URL}/#carson` },
    areaServed: 'US',
    priceRange: '$1,500 to $4,500 per month',
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Shopify plans',
      itemListElement: [
        ...PLANS.map((p) => ({
          '@type': 'Offer',
          name: p.name,
          description: p.tagline,
          price: p.price,
          priceCurrency: 'USD',
          priceSpecification: {
            '@type': 'UnitPriceSpecification',
            price: p.price,
            priceCurrency: 'USD',
            unitText: 'MONTH',
            billingDuration: 'P1M',
          },
        })),
        {
          '@type': 'Offer',
          name: 'Store Sprint',
          description: SPRINT.description,
          price: SPRINT.price,
          priceCurrency: 'USD',
        },
      ],
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: FAQS.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Layout
  title="Carson Cobb | Shopify Store Operator for DTC Brands"
  description="One senior operator to run your Shopify store end to end: conversion, development, retention, and operations. Monthly retainers for DTC brands, plus white label dev for agencies."
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="hero" aria-label="Introduction">
    <div class="hero__content">
      <span class="eyebrow">Full Store Shopify Operator</span>
      <h1>A whole team's worth of Shopify expertise, for one <em>monthly retainer</em>.</h1>
      <p class="hero__copy">
        Conversion, development, retention, and store operations. The range a DTC brand usually hires four or five
        people for, from one specialist who has done all of it. Plans from $1,500/mo.
      </p>
      <div class="hero__ctas">
        <Button href={CAL_LINK} track="book_call">Book a call</Button>
        <Button href="#results" variant="text">See my results</Button>
      </div>
      <p class="hero__status"><span class="hero__dot" aria-hidden="true"></span>Now booking new retainer clients.</p>
    </div>
    <svg class="hero__divider" viewBox="0 0 1200 100" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0,0 C600,100 600,0 1200,100 L1200,0 L0,0 Z"></path>
    </svg>
  </section>

  <!-- Proof bar -->
  <section class="proof" aria-label="Proof">
    <p class="eyebrow">Trusted by DTC brands across nearly every ecommerce vertical</p>
    <div class="proof__stats">
      {
        STATS.map((s) => (
          <div class="stat">
            <div class="stat__value">{s.value}</div>
            <div class="stat__label">{s.label}</div>
          </div>
        ))
      }
    </div>
    <p class="eyebrow proof__verticals">{VERTICALS.join(' · ')}</p>
    <p class="disclaimer">{DISCLAIMER}</p>
  </section>

  <!-- Plans -->
  <Section
    id="services"
    bg="alt"
    eyebrow="Services"
    title="Plans"
    intro="Every plan is a flat monthly retainer billed in advance. You get a dedicated queue, direct access to me, and a monthly recap of everything shipped."
  >
    <div class="grid grid--3 plans">
      {
        PLANS.map((p) => (
          <Card featured={p.featured} class="plan">
            {p.featured && <span class="plan__badge">Most Popular</span>}
            <h3 class="plan__name">{p.name}</h3>
            <p class="plan__price">
              {usd(p.price)}
              <span>/mo</span>
            </p>
            <p class="plan__best">Best for: {p.bestFor}</p>
            <p class="plan__tagline">{p.tagline}</p>
            <ul class="check-list">
              {p.includes.map((i) => (
                <li>{i}</li>
              ))}
            </ul>
            <Button href={CAL_LINK} track="book_call" variant={p.featured ? 'primary' : 'outline'} class="plan__cta">
              Book a call
            </Button>
          </Card>
        ))
      }
    </div>
    <p class="plans__terms">{PLAN_TERMS}</p>

    <Card class="sprint" as="article">
      <div class="sprint__intro">
        <span class="eyebrow">Not ready for a plan?</span>
        <h3 class="sprint__title">Store Sprint</h3>
        <p class="sprint__price">{usd(SPRINT.price)} fixed <span>· {SPRINT.duration}</span></p>
        <p class="sprint__desc">{SPRINT.description}</p>
      </div>
      <div class="sprint__details">
        <ul class="check-list">
          {SPRINT.includes.map((i) => <li>{i}</li>)}
        </ul>
        <Button href={CAL_LINK} track="book_call">Book a call</Button>
      </div>
    </Card>
  </Section>

  <!-- Results -->
  <Section id="results" eyebrow="Results" title="Real Stores. Real Results.">
    <div class="results__notes">
      <p class="disclaimer">{DISCLAIMER}</p>
      <p class="disclaimer">{RESULTS_NOTE}</p>
    </div>
    <div class="grid grid--3">
      {
        CASE_STUDIES.map((c) => (
          <Card as="article" class="case">
            <span class="case__tag">{c.tag}</span>
            <h3 class="case__title">{c.title}</h3>
            <h4>The Problem</h4>
            <p>{c.problem}</p>
            <h4>What I Did</h4>
            <p>{c.solution}</p>
            <div class="case__result">
              <div class="case__result-headline">{c.resultPrimary}</div>
              <div class="case__result-metric">{c.resultSecondary}</div>
            </div>
          </Card>
        ))
      }
    </div>
  </Section>

  <!-- Testimonials -->
  {
    TESTIMONIALS.length > 0 && (
      <section class="testimonials" aria-label="Testimonials">
        <div class="grid grid--2">
          {TESTIMONIALS.map((t) => (
            <Card as="article" class="testimonial">
              <span class="testimonial__mark" aria-hidden="true">“</span>
              <blockquote>{t.quote}</blockquote>
              <p class="testimonial__cite">
                <strong>{t.name}</strong>, {t.brand}
              </p>
            </Card>
          ))}
        </div>
      </section>
    )
  }

  <!-- Recent Work -->
  <Section
    id="work"
    bg="alt"
    eyebrow="Recent Work"
    title="What I've shipped lately."
    intro="A sample of recent projects. Names withheld; most of my work is under NDA."
  >
    <ul class="grid grid--4 work">
      {
        RECENT_WORK.map((w) => (
          <Card as="li" class="work__card">
            <span class="work__tag">{w.tag}</span>
            <h3>{w.title}</h3>
            <p>{w.text}</p>
            <p class="work__result">{w.result}</p>
          </Card>
        ))
      }
    </ul>
  </Section>

  <!-- The Problem -->
  <Section
    id="problem"
    bg="alt"
    eyebrow="The Problem"
    title="Hiring each skill separately is <em>expensive and disjointed</em>."
    intro="To cover everything a store needs, most DTC brands hire a designer, a developer, an SEO, and a retention person. That is four or five salaries or contractors, none of them cheap, and they rarely coordinate. You pay a fortune and still stitch the pieces together yourself."
  >
    <div class="grid grid--3">
      {
        PROBLEMS.map((p, i) => (
          <Card class="problem">
            <span class="problem__num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </Card>
        ))
      }
    </div>
  </Section>

  <!-- Process -->
  <Section id="process" eyebrow="Process" title="Here's How It Works">
    <ol class="grid grid--3 steps">
      {
        PROCESS.map((s, i) => (
          <li class="step">
            <span class="step__num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ol>
    <div class="center">
      <Button href={CAL_LINK} track="book_call" arrow>Book a call</Button>
    </div>
  </Section>

  <!-- Why Work With Me -->
  <Section
    id="why"
    bg="alt"
    eyebrow="Why Work With Me"
    title="One specialist. Every part of the store."
    intro="Most stores need conversion, development, retention, and operations handled. Brands usually hire four or five people for that. I have spent 6+ years across 50+ Shopify stores in nearly every DTC vertical building depth in all of it, so you get the full range without the full headcount."
  >
    <div class="about">
      {
        HEADSHOT ? (
          <img class="about__photo" src={HEADSHOT} alt="Carson Cobb" width="96" height="96" loading="lazy" />
        ) : (
          <span class="about__photo about__photo--initials" aria-hidden="true">
            CC
          </span>
        )
      }
      <p>
        I'm Carson. I've spent 6+ years inside 50+ Shopify stores, from scrappy founders to eight figure brands, and
        I've run stores end to end. I'm based in California and work with brands across the US.
      </p>
    </div>
    <div class="grid grid--2">
      {
        WHY_ME.map((w) => (
          <Card class="why">
            <h3>{w.title}</h3>
            <p>{w.text}</p>
          </Card>
        ))
      }
    </div>
  </Section>

  <!-- FAQ -->
  <Section id="faq" eyebrow="FAQ" title="Questions You're Probably Asking">
    <div class="faq">
      {
        FAQS.map((f) => (
          <details class="faq__item">
            <summary>
              {f.q}
              <span class="faq__icon" aria-hidden="true" />
            </summary>
            <p>
              {f.link ? (
                <Fragment>
                  {f.a.replace(f.link.text + '.', '')}
                  <a href={f.link.href}>{f.link.text}</a>.
                </Fragment>
              ) : (
                f.a
              )}
            </p>
          </details>
        ))
      }
    </div>
  </Section>

  <ContactCta
    title="Let's talk about <em>your store</em>."
    copy="Book a 20 minute call about your store. I will tell you honestly whether it is a fit, and what I would focus on first."
  />
</Layout>

<style is:global>
  /* Hero */
  .hero {
    position: relative;
    padding: 2rem var(--container-padding) 7rem;
    text-align: center;
    background: var(--color-bg);
  }

  .hero__content {
    position: relative;
    z-index: 1;
    max-width: 720px;
    margin: 0 auto;
  }

  .hero h1 {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    margin-bottom: 1.5rem;
  }

  .hero__copy {
    font-size: 1.2rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    margin-bottom: 1.5rem;
  }

  .hero__ctas {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .hero__status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }

  .hero__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22a447;
    box-shadow: 0 0 0 3px rgba(34, 164, 71, 0.18);
  }

  .hero__divider {
    position: absolute;
    left: 0;
    bottom: 0;
    display: block;
    width: 100%;
    height: 80px;
    fill: var(--color-bg-alt);
    transform: rotate(180deg) translateY(-1px);
  }

  /* Proof bar */
  .proof {
    padding: 2rem var(--container-padding);
    background: var(--color-bg-alt);
    text-align: center;
  }

  .proof__stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    max-width: var(--container-max);
    margin: 1.5rem auto 1.5rem;
  }

  .proof__verticals {
    margin-bottom: 1.25rem;
    color: var(--color-text-secondary);
  }

  .stat__value {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    color: var(--color-accent);
    line-height: 1.1;
    letter-spacing: var(--letter-spacing-heading);
    margin-bottom: 0.35rem;
  }

  .stat__label {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Plans */
  .plans {
    align-items: stretch;
  }

  .plans .plan {
    display: flex;
    flex-direction: column;
  }

  .plan__badge {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translate(-50%, -50%);
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
    background: var(--color-accent-text);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    white-space: nowrap;
  }

  .plan__name {
    font-size: 1.35rem;
    margin-bottom: 0.5rem;
  }

  .plan__price {
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-accent);
    line-height: 1.2;
    margin-bottom: 0.75rem;
  }

  .plan__price span {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .plan__best {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
    margin-bottom: 1rem;
  }

  .plan__tagline {
    font-weight: 600;
    line-height: 1.4;
    margin-bottom: 1.25rem;
  }

  .plans .check-list {
    flex: 1;
  }

  .plans .plan__cta {
    margin-top: auto;
  }

  .plans__terms {
    max-width: 720px;
    margin: 2rem auto 3rem;
    text-align: center;
    font-size: 0.9rem;
    color: var(--color-text-secondary);
  }

  .sprint {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 2.5rem;
    max-width: var(--container-max);
    margin: 0 auto;
    align-items: center;
  }

  .sprint__title {
    font-size: 1.75rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
  }

  .sprint__price {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--color-accent);
    margin-bottom: 1rem;
  }

  .sprint__price span {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .sprint__desc {
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  .sprint__details {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* Results */
  .results__notes {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin: -2rem auto 3rem;
  }

  .case {
    display: flex;
    flex-direction: column;
  }

  .case__tag {
    align-self: flex-start;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-eyebrow);
    color: var(--color-accent-text);
    background: rgba(var(--color-accent-rgb), 0.1);
    border: 1px solid rgba(var(--color-accent-rgb), 0.25);
    border-radius: 999px;
    padding: 0.35rem 0.75rem;
    margin-bottom: 0.85rem;
  }

  .case__title {
    font-size: 1.35rem;
    padding-bottom: 1rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .case h4 {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-accent-text);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-eyebrow);
    margin-bottom: 0.5rem;
  }

  .case p {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin-bottom: 1rem;
  }

  .case__result {
    margin-top: auto;
    padding: 1.75rem 1.5rem;
    background: var(--color-result-bg);
    border: 1px solid rgba(76, 175, 80, 0.3);
    border-radius: var(--radius-card);
    text-align: center;
  }

  .case__result-headline {
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: var(--letter-spacing-heading);
    margin-bottom: 0.5rem;
  }

  .case__result-metric {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-result-text);
  }

  /* Testimonials */
  .testimonials {
    padding: 0 var(--container-padding) var(--section-padding-y);
  }

  .testimonial {
    margin: 0;
  }

  .testimonial__mark {
    display: block;
    height: 2.5rem;
    font-size: 4.5rem;
    font-weight: 800;
    line-height: 1;
    color: var(--color-accent);
  }

  .testimonial blockquote {
    margin: 0 0 1rem;
    font-size: 1.1rem;
    line-height: 1.7;
  }

  .testimonial__cite {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
  }

  .testimonial strong {
    color: var(--color-text);
  }

  /* Recent Work */
  .work {
    list-style: none;
    padding: 0;
  }

  .work__card {
    display: flex;
    flex-direction: column;
    padding: 2rem 1.5rem;
  }

  .work__tag {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-eyebrow);
    color: var(--color-accent-text);
    margin-bottom: 0.6rem;
  }

  .work__card h3 {
    font-size: 1.05rem;
    line-height: 1.35;
    margin-bottom: 0.6rem;
  }

  .work__card p {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .work__card .work__result {
    margin-top: auto;
    padding-top: 1rem;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.4;
    color: var(--color-accent-text);
  }

  .work__card p:not(.work__result) {
    margin-bottom: 1rem;
  }

  /* Why Work With Me */
  .why h3 {
    font-size: 1.25rem;
    line-height: 1.3;
    margin-bottom: 1rem;
  }

  .why p,
  .problem p {
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  /* The Problem */
  .problem__num {
    display: block;
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1;
    color: var(--color-accent);
    letter-spacing: var(--letter-spacing-heading);
    margin-bottom: 1rem;
  }

  .problem h3 {
    font-size: 1.2rem;
    margin-bottom: 1rem;
  }

  .about {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    max-width: 720px;
    margin: -1rem auto 3rem;
    padding: 1.25rem 1.5rem;
    background: var(--color-card-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
  }

  .about p {
    line-height: 1.6;
  }

  .about__photo {
    flex-shrink: 0;
    width: 80px;
    height: 80px;
    border-radius: 50%;
    object-fit: cover;
  }

  .about__photo--initials {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-accent);
    color: #fff;
    font-weight: 800;
    font-size: 1.5rem;
  }

  /* FAQ */
  .faq {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 800px;
    margin: 0 auto;
  }

  .faq__item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-card-bg);
    box-shadow: 0 2px 8px var(--color-shadow);
    overflow: hidden;
    transition: var(--transition);
  }

  .faq__item:hover {
    border-color: var(--color-border-strong);
    box-shadow: 0 4px 12px var(--color-shadow-hover);
  }

  .faq__item[open] {
    border-color: var(--color-accent);
  }

  .faq summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding: 1.5rem 2rem;
    font-weight: 700;
    font-size: 1.05rem;
    cursor: pointer;
    list-style: none;
    transition: var(--transition);
  }

  .faq summary::-webkit-details-marker {
    display: none;
  }

  .faq summary:hover,
  .faq__item[open] summary {
    background: var(--color-bg-alt);
  }

  .faq__item[open] summary {
    border-bottom: 1px solid var(--color-border);
  }

  .faq__icon {
    position: relative;
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--color-bg-alt);
    transition: var(--transition);
  }

  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 12px;
    height: 2px;
    background: var(--color-text-secondary);
    transform: translate(-50%, -50%);
    transition: var(--transition);
  }

  .faq__icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .faq__item[open] .faq__icon {
    background: var(--color-accent);
  }

  .faq__item[open] .faq__icon::before,
  .faq__item[open] .faq__icon::after {
    background: #fff;
  }

  .faq__item[open] .faq__icon::after {
