---
import HomeLayout from '../layouts/HomeLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import {
  EMAIL,
  HEADSHOT,
  HOME_STATS,
  VERTICALS,
  VERTICALS_NOTE,
  RECOMMENDED,
  GAP_COST,
  CHAT_MOCK,
  HOME_RESULTS,
  STEPS,
  FAQS,
  ABOUT,
  CHECK_PATH,
  PROGRAM,
  CTA_LABEL,
} from '../data/site';
import { homeSchema } from '../data/schema';
import TopReports from '../components/TopReports.astro';
import '../styles/content.css';

const title = 'Carson Cobb | AI Search and CRO for Shopify Brands';
const description =
  'AI search and CRO for Shopify brands. I show you where competitors beat you in ChatGPT, Gemini and Google AI Mode, category by category, then close the gap.';

const faqs = FAQS;

const jsonLd = [homeSchema({ title, description, faqs })];
---

<HomeLayout {title} {description} {jsonLd}>
  <SiteNav />

  <main id="main">
    <!-- Hero -->
    <section class="dark" aria-label="Introduction">
      <div class="wrap hero hero--solo">
        <div class="hero__text">
          <p class="eyebrow">AI search and CRO for Shopify brands</p>
          <h1 class="hero__h1">AI is picking the winners in your market. <span class="accent">Make sure it picks you.</span></h1>
          <p class="hero__sub">
            I'm Carson Cobb, an independent AI search and conversion specialist for Shopify brands. When shoppers ask ChatGPT,
            Gemini and Google AI Mode what to buy, they get a short list. I show you where your competitors beat you, category by
            category, then close the gap and make sure the shoppers AI sends actually buy.
          </p>
          <div class="btn-row">
            <a href={CHECK_PATH} data-track="visibility_check" class="btn btn--accent"
              >{CTA_LABEL}
              <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
            </a>
            <a href={PROGRAM.path} class="btn btn--ghost-dark">See the program</a>
          </div>
          <p class="hero__note">No calls needed. You get a video, not a sales pitch.</p>
          <p class="hero__note">
            New to this? Read <a href="/guides/why-chatgpt-recommends-my-competitor">why ChatGPT recommends your competitor
            instead of you</a>, or see how <a href="/ai-search">AI search optimization for Shopify brands</a> works.
          </p>
        </div>
      </div>
    </section>

    <!-- Stat strip -->
    <section class="proof" aria-label="At a glance">
      <div class="wrap proof__inner">
        <div class="proof__stats">
          {
            HOME_STATS.map((s) => (
              <div>
                <div class="proof__value">{s.value}</div>
                <div class="proof__label">{s.label}</div>
              </div>
            ))
          }
        </div>
        <p class="tag">{VERTICALS.join(' · ')}</p>
        <p class="tag">{VERTICALS_NOTE}</p>
      </div>
    </section>

    <!-- What the gap costs you -->
    <section class="section" aria-labelledby="gap-cost">
      <div class="wrap stack">
        <div class="head">
          <p class="eyebrow">{GAP_COST.eyebrow}</p>
          <h2 class="h2" id="gap-cost">{GAP_COST.heading}</h2>
        </div>
        <div class="gapcost">
          <figure class="card gapcost__example" aria-label="Worked example">
            <span class="tag tag--accent">{GAP_COST.example.label}</span>
            <p class="gapcost__brand">{GAP_COST.example.brand}</p>
            <ul class="gapcost__lines">
              {GAP_COST.example.lines.map((l) => <li set:html={l} />)}
            </ul>
            <figcaption class="gapcost__note">{GAP_COST.example.note}</figcaption>
          </figure>
          <div class="gapcost__points">
            {
              GAP_COST.points.map((s, i) => (
                <div class="shift__item">
                  <span class="tag tag--accent">{String(i + 1).padStart(2, '0')}</span>
                  <h3 class="step__title">{s.title}</h3>
                  <p class="step__text" set:html={s.text} />
                </div>
              ))
            }
          </div>
        </div>
        <div class="btn-row">
          <a href={CHECK_PATH} data-track="visibility_check" class="btn btn--accent">{CTA_LABEL}</a>
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section class="section section--sand">
      <div class="wrap stack">
        <div class="head">
          <p class="eyebrow">How it works</p>
          <h2 class="h2">See the gap. Close it. Watch it move.</h2>
        </div>
        <div class="grid grid--300">
          {
            STEPS.map((s) => (
              <div class="step">
                <span class="tag tag--accent">{s.when}</span>
                <h3 class="step__title">{s.title}</h3>
                <p class="step__text">{s.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- What AI sees -->
    <section class="section" aria-labelledby="ai-sees">
      <div class="wrap ai-sees">
        <div class="head ai-sees__text">
          <p class="eyebrow">What AI sees</p>
          <h2 class="h2" id="ai-sees">This is the new shelf.</h2>
          <p class="lede">
            When a shopper asks ChatGPT what to buy, it names a few brands and moves on. There is no page two.
          </p>
          <p class="ai-sees__callout">{CHAT_MOCK.callout}</p>
          <div class="btn-row">
            <a href={CHECK_PATH} data-track="visibility_check" class="btn btn--accent">{CTA_LABEL}</a>
          </div>
        </div>
        <figure class="chat" aria-label="Example of an AI shopping answer with placeholder brands">
          <div class="chat__bar" aria-hidden="true"><span></span><span></span><span></span></div>
          <div class="chat__body">
            <p class="chat__bubble chat__bubble--user">{CHAT_MOCK.question}</p>
            <div class="chat__bubble chat__bubble--ai">
              <p>{CHAT_MOCK.intro}</p>
              <ol>
                {
                  CHAT_MOCK.picks.map((p) => (
                    <li>
                      <strong>{p.name}.</strong> {p.text}
                    </li>
                  ))
                }
              </ol>
            </div>
          </div>
          <figcaption class="chat__caption">Example answer. Brand names are placeholders.</figcaption>
        </figure>
      </div>
    </section>

    <!-- What gets a product recommended -->
    <section class="section section--sand" aria-labelledby="recommended">
      <div class="wrap stack">
        <div class="head">
          <p class="eyebrow">{RECOMMENDED.eyebrow}</p>
          <h2 class="h2" id="recommended">{RECOMMENDED.heading}</h2>
          <p class="lede">{RECOMMENDED.text}</p>
        </div>
        <div class="levers">
          {
            RECOMMENDED.cards.map((c, i) => (
              <div class="card lever">
                <span class="tag tag--accent">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="lever__title">{c.title}</h3>
                <p class="lever__text">{c.text}</p>
              </div>
            ))
          }
          <div class="card lever lever--wide">
            <span class="tag tag--accent">Then</span>
            <h3 class="lever__title">{RECOMMENDED.wide.title}</h3>
            <p class="lever__text">{RECOMMENDED.wide.text}</p>
          </div>
        </div>
        <p class="research-line">
          The research behind this: <a href="/reports/ai-search-benchmarks-shopify-2026">Shopify AI search benchmarks 2026</a>,
          <a href="/reports/chatgpt-gemini-ai-mode-brand-overlap-2026">ChatGPT vs Gemini vs Google AI Mode</a>
          and <a href="/reports/ai-search-statistics-2026">AI search statistics 2026</a>.
          {
            // Featured through December 2, 2026. Drops off at the first build after that date.
            new Date() < new Date('2026-12-03T00:00:00Z') && (
              <>New this week: <a href="/reports/black-friday-ai-deals-2026">which Black Friday deals AI recommends</a>.</>
            )
          }
          <a href="/reports" class="research-line__all">See all research →</a>
        </p>
      </div>
    </section>

    <!-- Proof -->
    <section id="results" class="section">
      <div class="wrap stack">
        <div class="head">
          <p class="eyebrow">Proof</p>
          <h2 class="h2">Recommended by AI. Chosen at checkout.</h2>
          <p class="lede">Real outcomes from past clients. Names withheld, since most of my work is under NDA or white label.</p>
        </div>
        <div class="grid grid--330">
          {
            HOME_RESULTS.map((r) => (
              <article class="card result">
                <div class="result__top">
                  <span class="tag tag--dim">{r.tag}</span>
                  <div class="result__stat">{r.stat}</div>
                  <div class="result__stat-label">{r.statLabel}</div>
                </div>
                <div class="result__body">
                  <h3 class="result__title">{r.title}</h3>
                  <div class="result__row">
                    <strong>Before:</strong> {r.before}
                  </div>
                  <div class="result__row">
                    <strong>After:</strong> {r.after}
                  </div>
                </div>
              </article>
            ))
          }
        </div>
        <div class="btn-row"><a href="/results" class="btn btn--outline">See all results</a></div>
        <p class="fineprint">Past client outcomes, shown as examples. Not a guarantee of results for any other store.</p>
      </div>
    </section>

    <!-- Pricing -->
    <section class="section section--sand" aria-labelledby="pricing-summary">
      <div class="wrap stack">
        <div class="head">
          <p class="eyebrow">Pricing</p>
          <h2 class="h2" id="pricing-summary">Two sizes, built around your gap.</h2>
          <p class="lede">Close the Gap starts at $2,500 a month, month to month, for brands doing $50K a month and up.</p>
        </div>
        <div class="btn-row">
          <a href="/pricing" class="btn btn--outline">See pricing</a>
          <a href={CHECK_PATH} data-track="visibility_check" class="btn btn--accent">{CTA_LABEL}</a>
        </div>
      </div>
    </section>

    <TopReports />

    <!-- About -->
    <section class="section">
      <div class="wrap">
        <div class="about">
          {
            HEADSHOT ? (
              <img class="about__photo" src={HEADSHOT} alt="Carson Cobb" width="220" height="260" loading="lazy" />
            ) : (
              <div class="about__photo" aria-hidden="true" />
            )
          }
          <div class="about__text">
            <p class="eyebrow">About</p>
            <h2 class="h2 h2--36">{ABOUT.heading}</h2>
            <p class="lede">{ABOUT.text}</p>
            <p class="about__where">{ABOUT.where}</p>
            <p class="about__where">
              More <a href="/about">about me</a>, and the <a href="/results">results behind the work</a>.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section section--flush">
      <div class="wrap faq">
        <div class="faq__head">
          <p class="eyebrow">FAQ</p>
          <h2 class="h2 h2--36">Questions, answered.</h2>
        </div>
        <div class="faq__list">
          {
            faqs.map((f, i) => (
              <details open={i === 0}>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section id="start" class="dark cta">
      <div class="wrap cta__inner">
        <h2 class="h2 cta__title">See who AI recommends instead of you.</h2>
        <p class="cta__sub">
          Get your gap report. It takes about a minute, no login, and shows how often ChatGPT recommends you against your
          top competitor. Then I send you a short video of your full gap.
        </p>
        <div class="btn-row btn-row--center">
          <a href={CHECK_PATH} data-track="visibility_check" class="btn btn--accent">{CTA_LABEL}</a>
          <a href={PROGRAM.path} class="btn btn--ghost-dark">See the program</a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</HomeLayout>
