---
import HomeLayout from '../layouts/HomeLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PriceSummary from '../components/PriceSummary.astro';
import {
  EMAIL,
  HEADSHOT,
  HOME_STATS,
  VERTICALS,
  RECOMMENDED,
  SHIFT,
  ENGINES,
  ENGINES_NOTE,
  CHAT_MOCK,
  RESULTS,
  STEPS,
  FAQS,
  ABOUT,
  CHECK_PATH,
  CTA_LABEL,
  HEADER_CTA_LABEL,
} from '../data/site';
import { homeSchema } from '../data/schema';
import '../styles/content.css';

const title = 'AI Search and CRO for Shopify Brands | Carson Cobb';
const description =
  'I get Shopify brands recommended in ChatGPT and Google AI answers, then turn that traffic into sales. AI search and CRO, from audit to ongoing growth.';

// The homepage FAQ covers AI search and pricing only.
const faqs = FAQS.filter((f) => !f.q.startsWith('Do you work with agencies'));

const jsonLd = [homeSchema({ title, description, faqs })];
---

<HomeLayout {title} {description} {jsonLd}>
  <SiteNav />

  <main id="main">
    <!-- Hero -->
    <section class="dark" aria-label="Introduction">
      <div class="wrap hero hero--solo">
        <div class="hero__text">
          <h1 class="hero__h1">More customers from AI. <span class="accent">More sales from every visit.</span></h1>
          <p class="hero__sub">
            AI search and CRO for Shopify brands. I get your products recommended in ChatGPT and Google's AI answers, then
            make sure your store turns that traffic into sales.
          </p>
          <div class="btn-row">
            <a href={CHECK_PATH} data-track="visibility_check" class="btn btn--accent"
              >{CTA_LABEL}
              <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
            </a>
            <a href="/results" class="btn btn--ghost-dark">See results</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Stat strip -->
    <section class="proof" aria-label="At a glance">
      <div class="wrap proof__inner">
        <div class="proof__stats">
          {
            HOME_STATS.map((s) => (
              <div>
                <div class="proof__value">{s.value}</div>
                <div class="proof__label">{s.label}</div>
              </div>
            ))
          }
        </div>
        <p class="tag">{VERTICALS.join(' · ')}</p>
      </div>
    </section>

    <!-- The shift -->
    <section class="section">
      <div class="wrap stack">
        <div class="head">
          <p class="eyebrow">The shift</p>
          <h2 class="h2">Your customers are asking AI what to buy.</h2>
          <p class="lede">
            Shoppers now ask ChatGPT for the best product for their exact problem, and it answers with a short list of
            brands. Those shoppers arrive ready to buy and convert far better than other traffic. If your store isn't giving
            AI the right information, you're not on that list, and a competitor is. And when they do find you, your store
            has to close the sale.
          </p>
        </div>
        <div class="grid grid--three shift">
          {
            SHIFT.map((s, i) => (
              <div class="shift__item">
                <span class="tag tag--accent">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="step__title">{s.title}</h3>
                <p class="step__text">{s.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Two engines -->
    <section class="section section--sand" aria-labelledby="engines">
      <div class="wrap stack">
        <div class="head">
          <p class="eyebrow">What I do</p>
          <h2 class="h2" id="engines">Two engines. One goal: more sales from AI.</h2>
        </div>
        <div class="grid engines">
          {
            ENGINES.map((e) => (
              <article class="card engine">
                <span class="tag tag--accent">{e.tag}</span>
                <h3 class="engine__title">{e.title}</h3>
                <p class="engine__text">{e.text}</p>
                <a class="engine__link" href={e.link.href}>
                  {e.link.text} →
                </a>
              </article>
            ))
          }
        </div>
        <p class="engines__note">{ENGINES_NOTE}</p>
      </div>
    </section>

    <!-- What AI sees -->
    <section class="section" aria-labelledby="ai-sees">
      <div class="wrap ai-sees">
        <div class="head ai-sees__text">
          <p class="eyebrow">What AI sees</p>
          <h2 class="h2" id="ai-sees">This is the new shelf.</h2>
          <p class="lede">
            When a shopper asks ChatGPT what to buy, it names a few brands and moves on. There is no page two.
          </p>
          <p class="ai-sees__callout">{CHAT_MOCK.callout}</p>
          <div class="btn-row">
            <a href={CHECK_PATH} data-track="visibility_check" class="btn btn--accent">{HEADER_CTA_LABEL}</a>
          </div>
        </div>
        <figure class="chat" aria-label="Example of an AI shopping answer with placeholder brands">
          <div class="chat__bar" aria-hidden="true"><span></span><span></span><span></span></div>
          <div class="chat__body">
            <p class="chat__bubble chat__bubble--user">{CHAT_MOCK.question}</p>
            <div class="chat__bubble chat__bubble--ai">
              <p>{CHAT_MOCK.intro}</p>
              <ol>
                {
                  CHAT_MOCK.picks.map((p) => (
                    <li>
                      <strong>{p.name}.</strong> {p.text}
                    </li>
                  ))
                }
              </ol>
            </div>
          </div>
          <figcaption class="chat__caption">Example answer. Brand names are placeholders.</figcaption>
        </figure>
      </div>
    </section>

    <!-- What gets a product recommended -->
    <section class="section section--sand" aria-labelledby="recommended">
      <div class="wrap stack">
        <div class="head">
          <p class="eyebrow">{RECOMMENDED.eyebrow}</p>
          <h2 class="h2" id="recommended">{RECOMMENDED.heading}</h2>
          <p class="lede">{RECOMMENDED.text}</p>
        </div>
        <div class="levers">
          {
            RECOMMENDED.cards.map((c, i) => (
              <div class="card lever">
                <span class="tag tag--accent">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="lever__title">{c.title}</h3>
                <p class="lever__text">{c.text}</p>
              </div>
            ))
          }
          <div class="card lever lever--wide">
            <span class="tag tag--accent">Then</span>
            <h3 class="lever__title">{RECOMMENDED.wide.title}</h3>
            <p class="lever__text">{RECOMMENDED.wide.text}</p>
          </div>
        </div>
        <p class="research-line">
          The research behind this: the <a href="/reports/shopify-ai-readiness-index-2026">Shopify AI Readiness Index 2026</a>
          and <a href="/reports/who-chatgpt-recommends-2026">Who ChatGPT recommends</a>.
          <a href="/reports" class="research-line__all">See all research →</a>
        </p>
      </div>
    </section>

    <!-- How it works -->
    <section class="section">
      <div class="wrap stack">
        <div class="head">
          <p class="eyebrow">How it works</p>
          <h2 class="h2">Audit, build, measure.</h2>
        </div>
        <div class="grid grid--300">
          {
            STEPS.map((s) => (
              <div class="step">
                <span class="tag tag--accent">{s.when}</span>
                <h3 class="step__title">{s.title}</h3>
                <p class="step__text">{s.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Proof -->
    <section id="results" class="section section--flush">
      <div class="wrap stack">
        <div class="head">
          <p class="eyebrow">Proof</p>
          <h2 class="h2">Recommended by AI. Chosen at checkout.</h2>
          <p class="lede">Real outcomes from past clients. Names withheld, since most of my work is under NDA or white label.</p>
        </div>
        <div class="grid grid--330">
          {
            RESULTS.map((r) => (
              <article class="card result">
                <div class="result__top">
                  <span class="tag tag--dim">{r.tag}</span>
                  <div class="result__stat">{r.stat}</div>
                  <div class="result__stat-label">{r.statLabel}</div>
                </div>
                <div class="result__body">
                  <h3 class="result__title">{r.title}</h3>
                  <div class="result__row">
                    <strong>Before:</strong> {r.before}
                  </div>
                  <div class="result__row">
                    <strong>After:</strong> {r.after}
                  </div>
                </div>
              </article>
            ))
          }
        </div>
        <p class="ways__more"><a href="/results">See all results →</a></p>
        <p class="fineprint">Past client outcomes, shown as examples. Not a guarantee of results for any other store.</p>
      </div>
    </section>

    <!-- Pricing summary -->
    <PriceSummary id="pricing-summary" />

    <!-- About -->
    <section class="section">
      <div class="wrap">
        <div class="about">
          {
            HEADSHOT ? (
              <img class="about__photo" src={HEADSHOT} alt="Carson Cobb" width="220" height="260" loading="lazy" />
            ) : (
              <div class="about__photo" aria-hidden="true" />
            )
          }
          <div class="about__text">
            <p class="eyebrow">About</p>
            <h2 class="h2 h2--36">{ABOUT.heading}</h2>
            <p class="lede">{ABOUT.text}</p>
            <p class="about__where">{ABOUT.where}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section section--flush">
      <div class="wrap faq">
        <div class="faq__head">
          <p class="eyebrow">FAQ</p>
          <h2 class="h2 h2--36">Questions, answered.</h2>
        </div>
        <div class="faq__list">
          {
            faqs.map((f, i) => (
              <details open={i === 0}>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section id="book" class="dark cta">
      <div class="wrap cta__inner">
        <h2 class="h2 cta__title">See where you stand in AI search.</h2>
        <p class="cta__sub">
          Run the free AI Visibility Check. In about a minute you'll see whether ChatGPT recommends you, who it recommends
          instead, and what's holding you back.
        </p>
        <div class="btn-row btn-row--center">
          <a href={CHECK_PATH} data-track="visibility_check" class="btn btn--accent">{HEADER_CTA_LABEL}</a>
          <a href={`mailto:${EMAIL}`} class="btn btn--ghost-dark">Email me</a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</HomeLayout>
