---
// /ai-search as a designed sales page. Title, description and FAQ come from src/content/pages/ai-search.md,
// whose sections are the collapsed "Read more" disclosures. Same URL and structured data as before.
import ContentPage from '../layouts/ContentPage.astro';
import PriceSummary from '../components/PriceSummary.astro';
import { contentSchema } from '../data/schema';
import { pageBySlug, CONTENT_PAGES } from '../data/pages';
import { designedPage, REPORTS, slugOf, shortVersion } from '../data/reports';
import { guideNamed } from '../data/guides';
import { AI_CASES, AI_CASES_NOTE, CHECK_PATH, HEADER_CTA_LABEL, HERO_PROOF } from '../data/site';
import '../styles/sales.css';

const slug = 'ai-search';
const { fm, section } = await designedPage(slug);
const info = pageBySlug(slug);
const faqs = (fm.faq ?? []).map((f) => ({ q: f.question, a: f.answer }));
const jsonLd = [
  contentSchema({ slug, title: fm.title, description: fm.description, label: info.label, faqs, service: info.service }),
];

// The mock answer. Placeholder brands only, and no real ChatGPT branding.
const picks = [
  { name: 'Brand A', text: 'Fragrance free, with a short ingredient list.', source: 'Review site' },
  { name: 'Brand B', text: 'Dermatologist tested and widely reviewed.', source: 'Magazine' },
  { name: 'Your brand?', text: 'This slot goes to whoever AI can read and trust.', source: 'Your store', you: true },
  { name: 'Brand D', text: 'Rich and calming for dry, reactive skin.', source: 'Forum thread' },
];

const stats = [
  {
    value: '70/100',
    text: "The typical Shopify store's AI readiness score.",
    href: '/reports/shopify-ai-readiness-index-2026',
  },
  {
    value: '29%',
    text: 'Of stores publish duplicate product data, usually from a review app.',
    href: '/reports/duplicate-product-schema-ai-visibility',
  },
  {
    value: 'Reviews and magazines',
    text: 'Review sites and magazines are the sources ChatGPT shows most.',
    href: '/reports/sources-chatgpt-cites-2026',
    words: true,
  },
];

// Why some products get named and others don't. Outcome first, no steps.
const reasons = [
  {
    title: 'AI recommends products it can describe with confidence.',
    text: 'When the facts about a product are thin or conflicting, AI names someone else, or describes you wrong.',
  },
  {
    title: 'AI checks what others say.',
    text: 'In depth reviews and comparisons of your products carry more weight than anything on your own site.',
  },
  {
    title: 'A recommendation only pays if the page converts.',
    text: 'AI sends shoppers straight to product pages, already told what to expect.',
  },
];

const steps = [
  { title: 'Measure what AI says today', text: 'I test the questions buyers ask about your products in ChatGPT and record who gets named, and why.' },
  { title: 'Fix what AI reads on your site', text: 'Product data built for each product, and product pages that answer buyer questions.' },
  { title: 'Earn the sources AI relies on', text: 'Real, in depth coverage in the reviews and comparisons AI leans on for products like yours.' },
  { title: 'Convert the traffic it sends', text: 'Product pages and checkout that confirm what AI told the shopper.' },
];

const promises = [
  'No one controls AI answers. Anyone promising a ChatGPT ranking is guessing.',
  'I make sure your store and your products are the easiest in your competitive set for AI to read, trust and recommend.',
  'I report honestly on every question, and focus the work where you can win.',
];

// "The research behind this", under what the audit measures. Each finding is the report's first
// "The short version" bullet, word for word.
const research = [
  'reports/chatgpt-gemini-ai-mode-brand-overlap-2026',
  'reports/how-question-wording-changes-ai-recommendations',
  'reports/what-ai-gets-wrong-about-products-2026',
].map((slug) => {
  const report = REPORTS.find((r) => slugOf(r) === slug);
  if (!report) throw new Error(`/ai-search research links to /${slug}, which is not a report`);
  return { href: `/${slug}`, title: report.frontmatter.h1, finding: shortVersion(report) };
});

const readMore = (headings: { heading: string; label?: string }[]) =>
  headings.map(({ heading, label }) => ({ title: label ?? heading, html: section(heading) }));
const whyMore = readMore([{ heading: 'What is AI search?' }]);
const workMore = readMore([
  { heading: 'What do I do on your site?', label: 'Everything I do on your site' },
  { heading: 'What do I do off site?', label: 'Everything I do off site' },
  { heading: 'How is AI search measured?' },
]);
// The guides linked from the Common questions block.
const commonQuestions = ['why-chatgpt-recommends-my-competitor', 'shopify-products-in-chatgpt-shopping', 'ai-search-optimization-cost-shopify'].map(guideNamed);
// The four product type pages, linked under the research card.
const industries = CONTENT_PAGES.filter((p) => p.kind === 'industry');
---

<ContentPage
  title={fm.title}
  description={fm.description}
  h1={fm.h1}
  intro="Get recommended when shoppers ask ChatGPT what to buy, and make sure the store converts them."
  trail={[{ name: info.label }]}
  {faqs}
  faqCollapsed
  {jsonLd}
>
  <Fragment slot="hero">
    <div class="sales-hero__actions">
      <a href={CHECK_PATH} data-track="visibility_check" class="btn btn--accent">{HEADER_CTA_LABEL}</a>
      <a href="/pricing" class="sales-hero__link">See pricing →</a>
    </div>
    <p class="sales-hero__proof">{HERO_PROOF.join(' · ')}</p>
  </Fragment>

  <!-- What the shopper sees -->
  <section class="section" aria-labelledby="shelf">
    <div class="wrap split">
      <div class="head">
        <p class="eyebrow">What the shopper sees</p>
        <h2 class="h2" id="shelf">A short list, not ten blue links.</h2>
        <p class="lede">Shoppers describe their problem to ChatGPT and get a few products back. There is no page two.</p>
        <p class="shelf-note">
          <span>
            This is the shelf now. <a href="/reports/who-chatgpt-recommends-2026">About 4 brands per answer.</a>
          </span>
        </p>
      </div>
      <figure class="chat" aria-label="Example of an AI shopping answer with placeholder brands">
        <div class="chat__bar" aria-hidden="true"><span></span><span></span><span></span></div>
        <div class="chat__body">
          <p class="chat__bubble chat__bubble--user">
            I have sensitive skin and fragrance makes it worse. What's a good natural moisturizer?
          </p>
          <div class="chat__bubble chat__bubble--ai">
            <p>Here are four good options for sensitive skin:</p>
            <ol class="chat__picks">
              {
                picks.map((p, i) => (
                  <li class:list={['chat__pick', p.you && 'chat__pick--you']}>
                    <span class="chat__num">{i + 1}.</span>
                    <p>
                      <strong>{p.name}</strong> {p.text}
                    </p>
                    <span class="chat__src">Source: {p.source}</span>
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
        <figcaption class="chat__caption">Example answer. Brand names are placeholders.</figcaption>
      </figure>
    </div>
  </section>

  <!-- Research stats -->
  <section class="section section--sand section--tight" aria-labelledby="research">
    <div class="wrap stack">
      <div class="head">
        <p class="eyebrow">From my research</p>
        <h2 class="h2" id="research">What AI finds on Shopify stores today.</h2>
      </div>
      <div class="grid grid--three">
        {
          stats.map((s) => (
            <a class="card stat-card" href={s.href}>
              <span class:list={['stat-card__value', s.words && 'stat-card__value--words']}>{s.value}</span>
              <p class="stat-card__text">{s.text}</p>
              <span class="stat-card__go">Read the report →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- What decides -->
  <section class="section" aria-labelledby="decides">
    <div class="wrap stack">
      <div class="head">
        <p class="eyebrow">How AI chooses</p>
        <h2 class="h2" id="decides">Why some products get named and others don't.</h2>
      </div>
      <div class="grid grid--three">
        {
          reasons.map((r, i) => (
            <div class="card reason">
              <span class="tag tag--accent">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="h3">{r.title}</h3>
              <p>{r.text}</p>
            </div>
          ))
        }
      </div>
      <p class="lede">I work through all three for the products that matter most to your revenue, and measure the change.</p>
      <p class="research">
        Related research: <a href="/reports/sources-chatgpt-cites-2026">the sources ChatGPT cites</a>,
        <a href="/reports/shopify-product-data-depth-2026">how deep Shopify product data is</a> and
        <a href="/reports/duplicate-product-schema-ai-visibility">conflicting product data from apps</a>.
      </p>
      <div class="readmore">
        {
          whyMore.map((m) => (
            <details>
              <summary>{m.title}</summary>
              <div class="prose" set:html={m.html} />
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- What I do -->
  <section class="section section--sand" aria-labelledby="what-i-do">
    <div class="wrap stack">
      <div class="head">
        <p class="eyebrow">What I do</p>
        <h2 class="h2" id="what-i-do">From measured to recommended to sold.</h2>
      </div>
      <ol class="process">
        {
          steps.map((s) => (
            <li>
              <h3 class="step__title">{s.title}</h3>
              <p class="step__text">{s.text}</p>
            </li>
          ))
        }
      </ol>
      <div class="card research-behind">
        <h3 class="h3">The research behind this</h3>
        <ul>
          {
            research.map((r) => (
              <li>
                <a href={r.href}>{r.title}</a>: {r.finding}
              </li>
            ))
          }
        </ul>
        <p class="research-behind__types">
          By product type:{' '}
          {industries.map((p, i) => (
            <><a href={`/${p.slug}`}>{p.label}</a>{i < industries.length - 2 ? ', ' : i === industries.length - 2 ? ' and ' : '.'}</>
          ))}
        </p>
      </div>
      <div class="readmore">
        {
          workMore.map((m) => (
            <details>
              <summary>{m.title}</summary>
              <div class="prose" set:html={m.html} />
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Results -->
  <section class="section" aria-labelledby="ai-results">
    <div class="wrap stack">
      <div class="head">
        <p class="eyebrow">Results</p>
        <h2 class="h2" id="ai-results">What AI search work has produced.</h2>
      </div>
      <div class="grid grid--330">
        {
          AI_CASES.map((r) => (
            <article class="card result">
              <div class="result__top">
                <span class="tag tag--dim">{r.tag}</span>
                <div class="result__stat">{r.stat}</div>
                <div class="result__stat-label">{r.statLabel}</div>
              </div>
              <div class="result__body">
                <h3 class="result__title">{r.title}</h3>
              </div>
            </article>
          ))
        }
      </div>
      <p class="fineprint">{AI_CASES_NOTE}</p>
      <p class="ways__more"><a href="/results#seo-aeo-and-ai-search">The full before and after for each →</a></p>
    </div>
  </section>

  <!-- What I won't promise -->
  <section class="section section--sand section--tight" aria-labelledby="promise">
    <div class="wrap">
      <div class="promise">
        <p class="eyebrow">Straight talk</p>
        <h2 class="h3" id="promise">What I won't promise.</h2>
        <ul>
          {promises.map((p) => <li>{p}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- Common questions -->
  <section class="section section--tight" aria-labelledby="common-questions">
    <div class="wrap">
      <div class="card research-behind">
        <h2 class="h3" id="common-questions">Common questions</h2>
        <ul>
          {commonQuestions.map((g) => <li><a href={`/${slugOf(g)}`}>{g.frontmatter.h1}</a></li>)}
        </ul>
      </div>
    </div>
  </section>

  <PriceSummary id="ai-pricing" sand={false} flush compact />
</ContentPage>
