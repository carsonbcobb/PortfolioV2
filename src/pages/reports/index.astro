---
// The /reports hub, from src/content/reports/index.md. The markdown renders as written, except the
// list under "Reports", which becomes one card per report with its checked date.
import ContentPage from '../../layouts/ContentPage.astro';
import { reportsIndexSchema } from '../../data/schema';
import { REPORT_HUB, REPORTS, slugOf, isoDate, shortDate, checkedDate } from '../../data/reports';

const fm = REPORT_HUB.frontmatter;
const faqs = (fm.faq ?? []).map((f) => ({ q: f.question, a: f.answer }));
const modified = fm.dateModified ? isoDate(fm.dateModified) : undefined;

// Split the rendered markdown around the Reports section and read its title, link and summary pairs.
const html = await REPORT_HUB.compiledContent();
const section = html.match(/(<h2 id="reports">[\s\S]*?<\/h2>)([\s\S]*?)(?=<h2)/);
if (!section) throw new Error('reports/index.md needs a "## Reports" section followed by another h2');
const before = html.slice(0, section.index! + section[1].length);
const after = html.slice(section.index! + section[0].length);
const cards = [...section[2].matchAll(/<h3[^>]*><a href="([^"]+)">([\s\S]*?)<\/a><\/h3>\s*<p>([\s\S]*?)<\/p>/g)].map(
  ([, href, title, summary]) => {
    const report = REPORTS.find((r) => `/${slugOf(r)}` === href);
    if (!report) throw new Error(`The Reports list links to ${href}, which is not a report`);
    return { href, title, summary, checked: checkedDate(report) };
  },
);

const jsonLd = [
  reportsIndexSchema(
    { title: fm.title, description: fm.description, dateModified: modified },
    REPORTS.map((r) => ({ slug: slugOf(r), name: r.frontmatter.h1 })),
    faqs,
  ),
];
---

<ContentPage
  title={fm.title}
  description={fm.description}
  h1={fm.h1}
  trail={[{ name: 'Reports' }]}
  dates={{ modified }}
  {faqs}
  {jsonLd}
>
  <section class="section page-body">
    <div class="wrap">
      <article class="prose" set:html={before} />
      <div class="tool-list report-list">
        {
          cards.map((c) => (
            <a class="card tool-card" href={c.href}>
              <p class="report-card__date">
                Checked <time datetime={c.checked}>{shortDate(c.checked)}</time>
              </p>
              <h3 class="h3" set:html={c.title} />
              <p set:html={c.summary} />
              <span class="tool-card__go">Read the report →</span>
            </a>
          ))
        }
      </div>
      <article class="prose" set:html={after} />
    </div>
  </section>
</ContentPage>
