---
// The /guides hub: one card per guide, in the order set in data/guides.ts.
import ContentPage from '../../layouts/ContentPage.astro';
import { guidesIndexSchema } from '../../data/schema';
import { GUIDES } from '../../data/guides';
import { slugOf } from '../../data/reports';

const title = 'AI Search Guides for Shopify Brands | Carson Cobb';
const intro = 'Plain answers to the questions founders ask about ChatGPT, Google AI and their Shopify store, based on my own data.';
const jsonLd = [
  guidesIndexSchema(
    { title, description: intro },
    GUIDES.map((g) => ({ slug: slugOf(g), name: g.frontmatter.h1 })),
  ),
];
---

<ContentPage {title} description={intro} h1="Guides: getting your Shopify brand recommended by AI" {intro} trail={[{ name: 'Guides' }]} {jsonLd}>
  <section class="section page-body">
    <div class="wrap">
      <div class="tool-list">
        {
          GUIDES.map((g) => (
            <a class="card tool-card" href={`/${slugOf(g)}`}>
              <h2 class="h3">{g.frontmatter.h1}</h2>
              <p>{g.frontmatter.description}</p>
              <span class="tool-card__go">Read the guide →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</ContentPage>
