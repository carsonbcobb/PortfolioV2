---
// /pricing: Close the Gap (Focus and Full), the Full Store Audit and the AI Visibility Check, the month 1
// guarantee, Fit and terms, and a short FAQ. Prices come from site.ts, the same data the schema uses.
import ContentPage from '../layouts/ContentPage.astro';
import SizeCard from '../components/SizeCard.astro';
import SizeCompare from '../components/SizeCompare.astro';
import { PROGRAM, PROGRAM_SIZES, FULL_AUDIT, CHECK_OFFER, PRICING_FAQS, TERMS_LIST, CHECK_PATH, CTA_LABEL, GAP_FIRST_LABEL } from '../data/site';
import { pricingSchema } from '../data/schema';

const usd = (n: number) => `$${n.toLocaleString('en-US')}`;

const title = 'Pricing for Close the Gap and the Full Store Audit | Carson Cobb';
const description =
  'Close the Gap at $2,500/month (Focus) or $5,000/month (Full) with a 3 month commitment, the $1,997 Full Store Audit, and your gap report, which takes about a minute, no login.';
const h1 = 'Pricing';
const intro =
  'Close the Gap, the 90 day program that beats your competitors in AI search, in two sizes. The Full Store Audit for conversion. And your gap report to see where you stand. Start online, no call needed.';

// The Fit and terms items are visible Q&A too, so they join the page's FAQPage.
const jsonLd = [pricingSchema({ title, description, faqs: [...PRICING_FAQS, ...TERMS_LIST] })];
---

<ContentPage {title} {description} {h1} {intro} trail={[{ name: 'Pricing' }]} faqs={PRICING_FAQS} {jsonLd}>
  <!-- Close the Gap -->
  <section class="section" id="close-the-gap" aria-labelledby="ctg-title">
    <div class="wrap stack">
      <div class="head">
        <p class="eyebrow">The main offer</p>
        <h2 class="h2" id="ctg-title">{PROGRAM.name}</h2>
        <p class="lede">{PROGRAM.summary}</p>
        <div class="btn-row">
          <a href={PROGRAM.path} class="btn btn--outline btn--small">See the full program</a>
        </div>
      </div>
      <div class="grid grid--320 plans">
        {
          PROGRAM_SIZES.map((z) => (
            <SizeCard size={z} id={z.key} extra="The 90 day program: find the gap and fix what you control, go after the sources, then expand and lock it in" />
          ))
        }
      </div>

      <SizeCompare />

      <div class="lock">
        <div class="lock__pill">
          <span class="lock__icon">
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#111214" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6l8-3z"></path><path d="M9 12l2 2 4-4"></path></svg>
          </span>
          <p><strong>Month 1 delivery guarantee.</strong> {PROGRAM.guarantee} {PROGRAM.guaranteeNote}</p>
        </div>
      </div>
      <p class="lock__terms plans__note">{PROGRAM.continues}</p>
      <p class="lock__terms plans__note">{PROGRAM.scope}</p>
      <p class="lock__terms plans__note">{PROGRAM.fit} {PROGRAM.under}</p>

      <!-- Lock in 2026 pricing -->
      <div class="lock">
        <div class="lock__pill">
          <span class="lock__icon">
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#111214" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="9" rx="2"></rect><path d="M8 11V8a4 4 0 018 0v3"></path></svg>
          </span>
          <p><strong>Lock in 2026 pricing.</strong> Start Close the Gap before January 1 and keep your committed monthly price for 12 months.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Full Store Audit and the AI Visibility Check -->
  <section class="section section--sand" aria-labelledby="more-title">
    <div class="wrap stack">
      <div class="head">
        <h2 class="h2" id="more-title">Also available</h2>
      </div>
      <div class="grid grid--320 plans">
        <div class="card plan" id="full-store-audit">
          <div class="plan__head">
            <span class="tag">One time · Conversion</span>
            <h3 class="h3">{FULL_AUDIT.name}</h3>
            <div class="plan__price">{usd(FULL_AUDIT.price)}</div>
          </div>
          <ul class="plan__list">
            {
              FULL_AUDIT.includes.map((i) => (
                <li>
                  <span aria-hidden="true">✓</span>
                  {i}
                </li>
              ))
            }
          </ul>
          <div class="plan__foot">
            <a href="/start?offer=full-store-audit" data-track="start_now" class="btn btn--outline">Start now</a>
            <a href={CHECK_PATH} data-track="visibility_check" class="btn btn--outline btn--small">{GAP_FIRST_LABEL}</a>
          </div>
        </div>

        <div class="card plan" id="check">
          <div class="plan__head">
            <span class="tag">Start here</span>
            <h3 class="h3">{CHECK_OFFER.name}</h3>
            <p class="plan__summary">{CHECK_OFFER.summary}</p>
          </div>
          <ul class="plan__list">
            <li><span aria-hidden="true">✓</span>Whether ChatGPT recommends you, and how often it picks your top competitor instead</li>
            <li><span aria-hidden="true">✓</span>What it says about your brand</li>
            <li><span aria-hidden="true">✓</span>Whether AI can read your store</li>
            <li><span aria-hidden="true">✓</span>{CHECK_OFFER.note}</li>
          </ul>
          <div class="plan__foot">
            <a href={CHECK_PATH} data-track="visibility_check" class="btn btn--accent">{CTA_LABEL}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="terms" aria-labelledby="terms-title">
    <div class="wrap faq">
      <div class="faq__head">
        <p class="eyebrow">Before you start</p>
        <h2 class="h2 h2--36" id="terms-title">Fit and terms</h2>
      </div>
      <div class="faq__list">
        {
          TERMS_LIST.map((t) => (
            <details>
              <summary>{t.q}</summary>
              <p>{t.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</ContentPage>
