---
// /pricing: the audit, Build tiers, retainer cards and comparison table, and a short FAQ.
// Prices come from site.ts, the same data the schema uses.
import ContentPage from '../layouts/ContentPage.astro';
import {
  AUDIT,
  BUILD,
  RETAINERS,
  RETAINER_ROWS,
  RETAINER_NOTE,
  PRICING_FAQS,
  MONTHLY_REPORT,
  DEVELOPERS_NOTE,
  TERMS_LIST,
  CHECK_PATH,
  CAL_LINK,
} from '../data/site';
import { pricingSchema } from '../data/schema';

const usd = (n: number) => `$${n.toLocaleString('en-US')}`;

// Booking buttons go to CAL_LINK and are tracked as book_call events.
const book = {
  href: CAL_LINK,
  'data-track': 'book_call',
  ...(CAL_LINK.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {}),
};

const title = 'Pricing for AI Search and CRO | Carson Cobb';
const description =
  'Start with a $1,500 AI search and conversion audit, then a fixed price Build from $5,000 or a retainer from $2,500 a month.';
const h1 = 'Pricing';
const intro =
  'Start with the $1,500 AI Search and Conversion Audit. Then implement the plan in a fixed price Build from $5,000, or on a retainer from $2,500 a month.';

// The Fit and terms items are visible Q&A too, so they join the page's FAQPage.
const jsonLd = [pricingSchema({ title, description, faqs: [...PRICING_FAQS, ...TERMS_LIST] })];
---

<ContentPage {title} {description} {h1} {intro} trail={[{ name: 'Pricing' }]} faqs={PRICING_FAQS} {jsonLd}>
  <section class="section">
    <div class="wrap stack">
      <div class="head">
        <h2 class="h2">Start with the audit. Grow from there.</h2>
      </div>

      <!-- Audit and Build -->
      <div class="grid grid--320 plans plans--start">
        <div class="card plan plan--featured" id="audit">
          <span class="plan__badge">{AUDIT.tag.toUpperCase()}</span>
          <div class="plan__head">
            <span class="tag tag--dim">One time</span>
            <h3 class="h3">{AUDIT.name}</h3>
            <div class="plan__price">{usd(AUDIT.price)}</div>
          </div>
          <ul class="plan__list">
            {
              AUDIT.includes.map((i) => (
                <li>
                  <span aria-hidden="true">✓</span>
                  {i}
                </li>
              ))
            }
          </ul>
          <div class="plan__foot">
            <div class="plan__note">{AUDIT.note}</div>
            <a {...book} class="btn btn--accent">Book the audit</a>
            <a href={CHECK_PATH} data-track="visibility_check" class="plan__alt">Not sure yet? Run the free check</a>
          </div>
        </div>

        <div class="card plan" id="build">
          <div class="plan__head">
            <span class="tag">{BUILD.tag}</span>
            <h3 class="h3">{BUILD.name}</h3>
            <ul class="plan__tiers">
              {
                BUILD.tiers.map((t) => (
                  <li>
                    <span>{t.label}</span>
                    <strong>
                      {t.from ? 'from ' : ''}
                      {usd(t.price)}
                    </strong>
                  </li>
                ))
              }
            </ul>
          </div>
          <ul class="plan__list">
            {
              BUILD.includes.map((i) => (
                <li>
                  <span aria-hidden="true">✓</span>
                  {i}
                </li>
              ))
            }
          </ul>
          <div class="plan__foot">
            <div class="plan__note">{BUILD.note}</div>
            <a {...book} class="btn btn--outline">Book a call</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--sand" id="retainers" aria-labelledby="retainers-title">
    <div class="wrap stack">
      <div class="head">
        <h2 class="h2" id="retainers-title">Retainers</h2>
        <p class="lede">Ongoing AI search and conversion work, with a 3 month minimum. {MONTHLY_REPORT}</p>
      </div>
      <div class="grid grid--four plans plans--retainers">
        {
          RETAINERS.map((r) => (
            <div class:list={['card', 'plan', { 'plan--featured': r.featured }]}>
              <div class="plan__head">
                <span class:list={['tag', { 'tag--dim': r.featured }]}>Retainer</span>
                <h3 class="h3">{r.name}</h3>
                <div class="plan__price">
                  {r.price === null ? "Let's talk" : usd(r.price)}
                  {r.price !== null && <span>{r.unit}</span>}
                </div>
                <p class="plan__summary">{r.summary}</p>
              </div>
              {r.includes.length > 0 && (
                <ul class="plan__list">
                  {r.includes.map((i) => (
                    <li>
                      <span aria-hidden="true">✓</span>
                      {i}
                    </li>
                  ))}
                </ul>
              )}
              <div class="plan__foot">
                {r.note && <div class="plan__note">{r.note}</div>}
                <a {...book} class:list={['btn', r.featured ? 'btn--accent' : 'btn--outline']}>
                  {r.price === null ? "Let's talk" : 'Book a call'}
                </a>
              </div>
            </div>
          ))
        }
      </div>

      <p class="plans__devs">{DEVELOPERS_NOTE}</p>

      <div class="prose retainers">
        <div class="table-scroll" tabindex="0" role="region" aria-label="Retainer comparison">
          <table>
            <thead>
              <tr>
                <th><span class="visually-hidden">Term</span></th>
                {RETAINERS.map((r) => <th scope="col">{r.name}</th>)}
              </tr>
            </thead>
            <tbody>
              {
                RETAINER_ROWS.map((row) => (
                  <tr>
                    <th scope="row">{row.label}</th>
                    {row.values.map((v) => (
                      <td>{v}</td>
                    ))}
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
      <p class="lock__terms plans__note">{RETAINER_NOTE}</p>

      <!-- Lock in 2026 pricing -->
      <div class="lock">
        <div class="lock__pill">
          <span class="lock__icon">
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#111214" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="9" rx="2"></rect><path d="M8 11V8a4 4 0 018 0v3"></path></svg>
          </span>
          <p><strong>Lock in 2026 pricing.</strong> Start before January 1 and keep today's rate for 12 months.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="terms" aria-labelledby="terms-title">
    <div class="wrap faq">
      <div class="faq__head">
        <p class="eyebrow">Before you book</p>
        <h2 class="h2 h2--36" id="terms-title">Fit and terms</h2>
      </div>
      <div class="faq__list">
        {
          TERMS_LIST.map((t) => (
            <details>
              <summary>{t.q}</summary>
              <p>{t.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</ContentPage>
