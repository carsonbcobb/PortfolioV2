---
// /close-the-gap: the main offer. Every line comes from PROGRAM and PROGRAM_SIZES in site.ts, the same data
// the pricing page, the homepage and the structured data use.
import ContentPage from '../layouts/ContentPage.astro';
import SizeCard from '../components/SizeCard.astro';
import SizeCompare from '../components/SizeCompare.astro';
import { PROGRAM, PROGRAM_SIZES, PROGRAM_FAQS, CHECK_PATH, CTA_LABEL, FULL_AUDIT } from '../data/site';
import { closeTheGapSchema } from '../data/schema';

const title = 'Close the Gap: Beat Competitors in AI Search | Carson Cobb';
const description =
  'Close the Gap shows Shopify brands where competitors beat them in ChatGPT, Gemini and Google AI Mode, then closes the gap. From $2,500 a month, month to month.';
const h1 = 'Close the Gap';
const intro =
  "AI is picking the winners in every product market, and right now it's picking your competitor. I show you exactly where your competitors beat you in ChatGPT, Gemini and Google AI Mode, category by category, and what that's costing you. Then I close the gap.";

const jsonLd = [closeTheGapSchema({ title, description, faqs: PROGRAM_FAQS })];
---

<ContentPage {title} {description} {h1} {intro} trail={[{ name: 'Pricing', href: '/pricing' }, { name: PROGRAM.name }]} faqs={PROGRAM_FAQS} {jsonLd}>
  <div slot="hero" class="stack">
    <div class="btn-row">
      <a href={CHECK_PATH} data-track="visibility_check" class="btn btn--accent">{CTA_LABEL}</a>
      <a href="#sizes" class="btn btn--ghost-dark">See the two sizes</a>
    </div>
    <p class="hero__note">No calls needed. You get a video, not a sales pitch.</p>
  </div>

  <!-- The promise -->
  <section class="section">
    <div class="wrap stack">
      <div class="head">
        <p class="eyebrow">The promise</p>
        <h2 class="h2">What I can and can't do.</h2>
        <p class="lede">{PROGRAM.promise}</p>
      </div>
    </div>
  </section>

  <!-- The program -->
  <section class="section section--sand" aria-labelledby="program">
    <div class="wrap stack">
      <div class="head">
        <p class="eyebrow">The program</p>
        <h2 class="h2" id="program">90 days to close the gap.</h2>
      </div>
      <div class="grid grid--three plans">
        {
          PROGRAM.months.map((m) => (
            <div class="card plan">
              <div class="plan__head">
                <span class="tag">{m.when}</span>
                <h3 class="h3">{m.title}</h3>
              </div>
              <ul class="plan__list">
                {m.items.map((i) => (
                  <li>
                    <span aria-hidden="true">✓</span>
                    {i}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <div class="card plan">
        <div class="plan__head">
          <span class="tag">The whole time</span>
          <h3 class="h3">{PROGRAM.always.title}</h3>
        </div>
        <ul class="plan__list">
          {
            PROGRAM.always.items.map((i) => (
              <li>
                <span aria-hidden="true">✓</span>
                {i}
              </li>
            ))
          }
        </ul>
      </div>
      <p class="lede">{PROGRAM.after}</p>
    </div>
  </section>

  <!-- Two sizes -->
  <section class="section" id="sizes" aria-labelledby="sizes-title">
    <div class="wrap stack">
      <div class="head">
        <p class="eyebrow">Pricing</p>
        <h2 class="h2" id="sizes-title">Two sizes.</h2>
      </div>
      <div class="grid grid--320 plans">
        {PROGRAM_SIZES.map((z) => <SizeCard size={z} id={z.key} extra="Everything in the 90 day program above" />)}
      </div>

      <div class="head">
        <h3 class="h3">{PROGRAM.scopeTitle}</h3>
        <p class="lede">{PROGRAM.scopeText}</p>
      </div>

      <SizeCompare />

      <div class="lock">
        <div class="lock__pill">
          <span class="lock__icon">
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#111214" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6l8-3z"></path><path d="M9 12l2 2 4-4"></path></svg>
          </span>
          <p><strong>Month 1 delivery guarantee.</strong> {PROGRAM.guarantee} {PROGRAM.guaranteeNote}</p>
        </div>
      </div>
      <p class="lock__terms plans__note">{PROGRAM.continues}</p>
      <p class="lock__terms plans__note">{PROGRAM.scope}</p>
    </div>
  </section>

  <!-- Who it's for -->
  <section class="section section--sand" aria-labelledby="fit">
    <div class="wrap stack">
      <div class="head">
        <p class="eyebrow">Who it's for</p>
        <h2 class="h2" id="fit">Brands that want to beat a specific competitor.</h2>
        <p class="lede">{PROGRAM.fit}</p>
        <p class="lede">{PROGRAM.fitNote}</p>
        <p class="lede">{PROGRAM.under}</p>
      </div>
      <div class="btn-row">
        <a href={FULL_AUDIT.path} class="btn btn--outline">See the Full Store Audit</a>
      </div>
    </div>
  </section>

  <!-- How to start -->
  <section class="section" id="start" aria-labelledby="start-title">
    <div class="wrap stack">
      <div class="head">
        <p class="eyebrow">No call needed</p>
        <h2 class="h2" id="start-title">How to start</h2>
      </div>
      <div class="grid grid--300">
        {
          PROGRAM.startSteps.map((st, i) => (
            <div class="step">
              <span class="tag tag--accent">Step {i + 1}</span>
              <h3 class="step__title">{st.title}</h3>
              <p class="step__text">{st.text}</p>
            </div>
          ))
        }
      </div>
      <div class="btn-row">
        <a href={CHECK_PATH} data-track="visibility_check" class="btn btn--accent">{CTA_LABEL}</a>
      </div>
    </div>
  </section>
</ContentPage>
