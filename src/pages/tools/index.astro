---
import ContentPage from '../../layouts/ContentPage.astro';
import { toolsIndexSchema } from '../../data/schema';
import { TOOLS, CONTENT_PAGES } from '../../data/pages';
import { CHECK_PATH } from '../../data/site';

const title = 'Shopify Tools for Growing Brands | Carson Cobb';
const description =
  'Free tools for Shopify brands: the AI Visibility Check, a subscription revenue calculator and a free shipping threshold calculator.';
const intro =
  'Quick tools built from the checks I run in every store audit. Everything runs in your browser and nothing is saved.';
// The AI Visibility Check leads, then the calculators.
const cards = [
  {
    href: CHECK_PATH,
    name: 'AI Visibility Check',
    summary: 'See whether ChatGPT recommends your brand, who it names instead, and whether AI can read your store.',
    go: 'Run the check →',
  },
  ...TOOLS.map((t) => ({ href: `/tools/${t.slug}`, name: t.name.charAt(0).toUpperCase() + t.name.slice(1), summary: t.summary, go: 'Open the calculator →' })),
];
// Comparison guides live here too, since the footer no longer links them.
const guides = CONTENT_PAGES.filter((p) => p.kind === 'guide');
const jsonLd = [toolsIndexSchema({ title, description }, cards)];
---

<ContentPage {title} {description} h1="Tools for Shopify brands" {intro} trail={[{ name: 'Tools' }]} {jsonLd}>
  <section class="section page-body">
    <div class="wrap">
      <div class="tool-list">
        {
          cards.map((t) => (
            <a class="card tool-card" href={t.href}>
              <h2 class="h3">{t.name}</h2>
              <p>{t.summary}</p>
              <span class="tool-card__go">{t.go}</span>
            </a>
          ))
        }
      </div>
      <h2 class="h2 tool-guides__title">Guides</h2>
      <div class="tool-list">
        {
          guides.map((g) => (
            <a class="card tool-card" href={`/${g.slug}`}>
              <h3 class="h3">{g.label}</h3>
              <p>{g.summary}</p>
              <span class="tool-card__go">Read the guide →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</ContentPage>
