---
// The Store Check is retired. The real 301 to /ai-visibility-check is an Amplify "Rewrites and redirects" rule
// (source /tools/store-check, target /ai-visibility-check, type 301). This page only catches old links if that
// rule is missing: it forwards at once, is kept out of search, and is not in the sitemap, footer or llms.txt.
import { SITE_URL, CHECK_PATH } from '../../data/site';
const target = `${SITE_URL}${CHECK_PATH}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${CHECK_PATH}`} />
    <link rel="canonical" href={target} />
    <title>Moved to the AI Visibility Check</title>
  </head>
  <body>
    <h1>The Store Check has moved</h1>
    <p>It is now part of the <a href={CHECK_PATH}>AI Visibility Check</a>.</p>
  </body>
</html>
