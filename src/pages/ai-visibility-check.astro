---
// /ai-visibility-check: the gap report as a step flow inside one screen.
// Step 1 takes the store, top competitor, monthly revenue, name and email. Step 2 runs the check
// (the Worker in worker/ streams NDJSON). Step 3 is the head to head and the score, steps 4 to 7
// are one section each, and step 8 is the next step for the visitor's revenue range.
// Explanatory content and the FAQ sit below the tool for search.
import HomeLayout from '../layouts/HomeLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { CHECK_API_URL, TURNSTILE_SITE_KEY, CHECK_FAQS } from '../data/site';
import { checkSchema } from '../data/schema';
import '../styles/content.css';
import '../styles/check.css';
import '../styles/sales.css';

const title = 'Get your gap report | Carson Cobb';
const description =
  'The gap report for Shopify brands: enter your store and your top competitor, and see how often ChatGPT recommends each of you, in about a minute.';

const ready = Boolean(CHECK_API_URL && TURNSTILE_SITE_KEY);

// What each score measures and why it matters. Never how to fix it: that is Close the Gap.
const SCORES = [
  {
    name: 'AI visibility',
    weight: 40,
    checked: 'Whether ChatGPT names your brand when shoppers ask about products like your best sellers, how high it puts you, and which sources it leans on for the answer.',
    means: 'A low score means shoppers who are ready to buy are being sent to the products AI names instead of yours.',
  },
  {
    name: 'Site readiness',
    weight: 25,
    checked: 'How much your top product pages tell AI about each product, and how your product page compares with the competitor AI named most.',
    means: "A low score means AI can't describe your products with confidence, so it's less likely to recommend them or more likely to get them wrong.",
  },
  {
    name: 'Brand accuracy',
    weight: 20,
    checked: 'Whether ChatGPT describes your brand and what you sell correctly when someone asks about you by name.',
    means: 'A low score means shoppers who already know your name get the wrong picture before they reach your store.',
  },
  {
    name: 'Crawler access',
    weight: 15,
    checked: 'Whether the crawlers behind ChatGPT and other AI tools can reach your store at all.',
    means: "A low score means AI can't read your pages, so it can't recommend what's on them.",
  },
];

// "Why does this matter?" strip. Each figure links to the report it comes from.
const MATTERS = [
  { value: 'About 4', text: 'brands per ChatGPT answer.', href: '/reports/who-chatgpt-recommends-2026', go: 'Read the report →' },
  {
    value: 'About 49%',
    text: 'better conversion from AI referred shoppers than search shoppers (Shopify, 2026).',
    href: '/reports/ai-search-ecommerce-whats-real',
    go: 'See the source →',
  },
  { value: '29%', text: 'of Shopify stores publish duplicate product data.', href: '/reports/duplicate-product-schema-ai-visibility', go: 'Read the report →' },
];

const jsonLd = [checkSchema({ title, description, faqs: CHECK_FAQS })];
---

<HomeLayout {title} {description} {jsonLd}>
  <SiteNav />

  <main id="main">
    <section class="dark flow" id="flow" aria-label="Gap report" data-step="1">
      <p class="visually-hidden" id="flow-live" aria-live="polite"></p>

      <!-- Step 1: the gap report form -->
      <div class="flow__step is-active" data-step="1">
        <div class="wrap flow__inner flow__inner--center">
          <p class="eyebrow">Gap report</p>
          <h1 class="flow__h1" tabindex="-1">See who AI recommends instead of you.</h1>
          <p class="flow__sub">
            Enter your store and your top competitor. In about a minute you'll see how often ChatGPT recommends each of
            you. For brands doing $50K a month or more, I'll follow up with a short video of your full gap and what it's
            worth.
          </p>
          {
            ready ? (
              <Fragment>
                <form id="store-form" class="flow__form gapform" novalidate>
                  <div class="gapform__field">
                    <label for="store-url">Your store</label>
                    <input id="store-url" name="url" type="text" inputmode="url" autocomplete="url" placeholder="yourstore.com" required />
                  </div>
                  <div class="gapform__field">
                    <label for="store-rival">Top competitor</label>
                    <input id="store-rival" name="competitor" type="text" autocomplete="off" maxlength="100" placeholder="Their website or brand name" required />
                  </div>
                  <div class="gapform__field">
                    <label for="store-revenue">Monthly revenue</label>
                    <select id="store-revenue" name="revenue" required>
                      <option value="" selected disabled>Choose a range</option>
                      <option value="under_50k">Under $50K</option>
                      <option value="50k_150k">$50K to $150K</option>
                      <option value="150k_plus">$150K+</option>
                    </select>
                  </div>
                  <div class="gapform__field">
                    <label for="store-name">Name</label>
                    <input id="store-name" name="name" type="text" autocomplete="name" maxlength="80" placeholder="Your name" />
                  </div>
                  <div class="gapform__field">
                    <label for="store-email">Work email</label>
                    <input id="store-email" name="email" type="email" autocomplete="email" placeholder="you@yourbrand.com" required />
                  </div>
                  <div class="gapform__field gapform__submit">
                    <button type="submit" class="btn btn--accent" data-label="Get my gap report">Get my gap report</button>
                  </div>
                </form>
                <p class="flow__fine" id="store-fine">Takes about a minute. No login.</p>
                <p class="flow__error" id="store-error" role="alert" hidden></p>
                <div id="ts-box" class="flow__turnstile"></div>
              </Fragment>
            ) : (
              <Fragment>
                <p class="flow__notice">
                  The gap report is being set up. In the meantime, email me your store and your top competitor and I'll
                  send yours.
                </p>
                <div class="flow__actions">
                  <a class="btn btn--accent" href="mailto:carson@carsoncobb.com?subject=Gap%20report">Email carson@carsoncobb.com</a>
                </div>
              </Fragment>
            )
          }
          <p class="flow__fine flow__research">
            See how 617 Shopify brand stores compare in the
            <a href="/reports/ai-search-benchmarks-shopify-2026">Shopify AI search benchmarks</a>.
          </p>
        </div>
      </div>

      <!-- Step 2: running -->
      <div class="flow__step" data-step="2" hidden>
        <div class="wrap flow__inner flow__inner--split">
          <div class="flow__col">
            <p class="eyebrow">Running your gap report</p>
            <h2 class="flow__h2" tabindex="-1" id="run-title">Checking your store</h2>
            <ol class="run" id="run-list"></ol>
            <p class="flow__error" id="run-error" role="alert" hidden></p>
            <button type="button" class="btn btn--outline-dark" data-action="restart" id="run-retry" hidden>Try again</button>
          </div>
          <div class="card card--dark flow__email" id="run-card">
            <p class="flow__email-q" id="run-vs">You against your competitor</p>
            <p class="flow__body" id="run-note">Your results open here as soon as the check finishes.</p>
          </div>
        </div>
      </div>

      <!-- Step 3: the head to head first, then the score -->
      <div class="flow__step" data-step="3" hidden>
        <div class="wrap flow__inner flow__inner--report">
          <div class="h2h" id="h2h" hidden></div>
          <div class="report__split">
            <div class="score">
              <svg class="dial" viewBox="0 0 120 120" aria-hidden="true">
                <circle class="dial__track" cx="60" cy="60" r="52"></circle>
                <circle class="dial__fill" cx="60" cy="60" r="52" pathLength="100"></circle>
              </svg>
              <div class="score__num"><span id="score-num">0</span><small>of 100</small></div>
            </div>
            <div class="flow__col">
              <p class="eyebrow" id="score-eyebrow">Your AI visibility score</p>
              <h2 class="flow__h2" tabindex="-1" id="score-verdict"></h2>
              <ol class="findings" id="findings"></ol>
              <div class="flow__actions">
                <button type="button" class="btn btn--accent" data-action="next">See the breakdown</button>
                <button type="button" class="btn btn--outline-dark" data-action="close">See your next step</button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Steps 4 to 7: one section each. Filled in by the script. -->
      <div class="flow__step" data-step="4" hidden><div class="wrap flow__inner"><div class="card card--dark sect" id="sect-visibility"></div></div></div>
      <div class="flow__step" data-step="5" hidden><div class="wrap flow__inner"><div class="card card--dark sect" id="sect-accuracy"></div></div></div>
      <div class="flow__step" data-step="6" hidden><div class="wrap flow__inner"><div class="card card--dark sect" id="sect-crawlers"></div></div></div>
      <div class="flow__step" data-step="7" hidden><div class="wrap flow__inner"><div class="card card--dark sect" id="sect-readiness"></div></div></div>

      <!-- Step 8: the next step, by monthly revenue. The script shows one block. -->
      <div class="flow__step" data-step="8" hidden>
        <div class="wrap flow__inner flow__inner--center">
          <div class="close__text">
            <p class="eyebrow">Your next step <span class="close__score" id="close-score"></span></p>
            <div class="next" data-next="fit" hidden>
              <h2 class="flow__h2" tabindex="-1">Your gap video is on its way.</h2>
              <p class="flow__body">
                I'll email it to <strong class="next__email" id="next-email">you</strong> within 1 business day. It covers
                your top products against your competitors, roughly what the gap is worth each month, and the program that
                fits.
              </p>
              <div class="flow__actions">
                <a class="btn btn--accent" href="/close-the-gap?from=gap-report" data-track="close_the_gap">See Close the Gap</a>
              </div>
            </div>
            <div class="next" data-next="under" hidden>
              <h2 class="flow__h2" tabindex="-1">Close the Gap is built for brands doing $50K a month and up.</h2>
              <p class="flow__body">
                At your stage, the best next step is the Full Store Audit: every page of your store, your email flows,
                analytics and how AI sees your products, with every fix ranked by what it's worth, back to you in 2
                business days.
              </p>
              <div class="flow__actions">
                <a class="btn btn--accent" href="/full-store-audit?from=gap-report" data-track="full_store_audit">Get the Full Store Audit</a>
              </div>
            </div>
            <div class="next" data-next="none" hidden>
              <h2 class="flow__h2" tabindex="-1">This is one run. Your buyers ask far more.</h2>
              <p class="flow__body">
                Close the Gap puts you head to head against your main competitors across your top products. Every fix
                comes to your team ready to ship, or I implement them for you, and you get a competitor report every week
                or two showing where you stand. It's built for
                brands doing $50K a month and up.
              </p>
              <div class="flow__actions">
                <a class="btn btn--accent" href="/close-the-gap?from=gap-report" data-track="close_the_gap">See Close the Gap</a>
              </div>
            </div>
            <p class="flow__fine" id="sent-line"></p>
          </div>
        </div>
      </div>

      <!-- Back, progress dots and Next on every result step -->
      <nav class="flow__nav" aria-label="Report steps" hidden>
        <div class="wrap flow__nav-inner">
          <button type="button" class="flow__nav-btn" data-action="back">← Back</button>
          <ol class="dots" id="dots"></ol>
          <button type="button" class="flow__nav-btn flow__nav-btn--next" data-action="next">Next →</button>
        </div>
      </nav>

    </section>

    <!-- The check vs Close the Gap -->
    <section class="section section--sand section--tight" aria-labelledby="compare-title">
      <div class="wrap stack">
        <h2 class="h2 h2--36" id="compare-title">How is this different from Close the Gap?</h2>
        <div class="grid compare">
          <div class="card compare__col">
            <p class="tag">About a minute, no login</p>
            <h3 class="h3">This gap report</h3>
            <ul>
              <li>Your store against one competitor</li>
              <li>Questions built from your products</li>
              <li>One run</li>
              <li>A snapshot of where you stand today</li>
            </ul>
          </div>
          <div class="card compare__col compare__col--paid">
            <p class="tag tag--accent">90 days</p>
            <h3 class="h3">Close the Gap</h3>
            <p class="compare__line">You, head to head against your main competitors.</p>
            <ul>
              <li>Your top products, against your main competitors</li>
              <li>Every fix ready to ship, or implemented for you</li>
              <li>A competitor report every week or two</li>
            </ul>
            <div class="compare__cta">
              <a class="btn btn--accent" href="/close-the-gap?from=gap-report" data-track="close_the_gap">See how Close the Gap works</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Why it matters -->
    <section class="section section--tight" aria-labelledby="matters-title">
      <div class="wrap stack">
        <h2 class="h2 h2--36" id="matters-title">Why does this matter?</h2>
        <div class="grid grid--three">
          {
            MATTERS.map((m) => (
              <a class="card stat-card" href={m.href}>
                <span class="stat-card__value">{m.value}</span>
                <p class="stat-card__text">{m.text}</p>
                <span class="stat-card__go">{m.go}</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- What each score means -->
    <section class="section section--sand section--tight" aria-labelledby="scores-title">
      <div class="wrap stack">
        <div class="head">
          <h2 class="h2 h2--36" id="scores-title">What does each score mean?</h2>
          <p class="lede">
            Your overall score runs from 0 to 100. It weights the four checks by how much they affect whether AI recommends
            you: AI visibility 40%, site readiness 25%, brand accuracy 20% and crawler access 15%.
          </p>
        </div>
        <div class="score-cards">
          {
            SCORES.map((sc) => (
              <details class="card score-card">
                <summary>
                  <span>{sc.name}</span>
                  <span class="score-card__weight">{sc.weight}%</span>
                </summary>
                <p>
                  <strong>What we check:</strong> {sc.checked}
                </p>
                <p>
                  <strong>Why it matters:</strong> {sc.means}
                </p>
                <p>Close the Gap covers what to do about it.</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section section--sand" id="faq">
      <div class="wrap faq">
        <div class="faq__head">
          <p class="eyebrow">FAQ</p>
          <h2 class="h2 h2--36">Questions, answered.</h2>
        </div>
        <div class="faq__list">
          {
            CHECK_FAQS.map((f, i) => (
              <details open={i === 0}>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</HomeLayout>

{
  ready && (
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=aivcTurnstile" async defer />
  )
}

<script is:inline src="/check-flow.js" data-api={CHECK_API_URL} data-sitekey={TURNSTILE_SITE_KEY} defer></script>
