---
// Footer for every page: link columns, then the contact and trademark line.
import { EMAIL, LINKEDIN_URL, REFERRAL, CHECK_PATH } from '../data/site';
import { CONTENT_PAGES } from '../data/pages';

const year = new Date().getFullYear();
const link = (slug: string) => ({ href: `/${slug}`, label: CONTENT_PAGES.find((p) => p.slug === slug)!.label });

const columns = [
  {
    title: 'Services',
    links: [
      { href: '/ai-search', label: 'AI search optimization' },
      { href: '/shopify-conversion-optimization', label: 'Conversion optimization' },
      { href: '/fractional-head-of-ecommerce', label: 'Full store management' },
      { href: '/pricing', label: 'Pricing' },
    ],
  },
  {
    title: 'Industries',
    links: CONTENT_PAGES.filter((p) => p.kind === 'industry').map((p) => link(p.slug)),
  },
  {
    title: 'Resources',
    links: [
      { href: CHECK_PATH, label: 'AI Visibility Check' },
      { href: '/reports', label: 'Reports' },
      { href: '/guides', label: 'Guides' },
      { href: '/reports/chatgpt-gemini-ai-mode-brand-overlap-2026', label: 'ChatGPT vs Gemini vs AI Mode' },
      { href: '/reports/ai-search-statistics-2026', label: 'AI search statistics 2026' },
      { href: '/reports/what-ai-gets-wrong-about-products-2026', label: 'What AI gets wrong about products' },
    ],
  },
  {
    title: 'Carson Cobb',
    links: [
      { href: '/', label: 'Home' },
      { href: '/results', label: 'Results' },
      { href: '/agencies', label: 'Agencies' },
      { href: '/tools', label: 'All tools' },
    ],
  },
];
---

<footer class="dark footer">
  <div class="wrap footer__referral">
    <div>
      <p class="footer__referral-title">{REFERRAL.title}</p>
      <p>{REFERRAL.text}</p>
    </div>
    <a href={`mailto:${EMAIL}?subject=Referral`} class="btn btn--ghost-dark">Make an intro</a>
  </div>
  <nav class="wrap footer__cols" aria-label="Footer">
    {
      columns.map((c) => (
        <div class="footer__col">
          <p class="tag tag--dim">{c.title}</p>
          <ul>
            {c.links.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </nav>
  <div class="wrap footer__inner">
    <span>
      © {year} Carson Cobb · <a href={`mailto:${EMAIL}`}>{EMAIL}</a> · <a href={LINKEDIN_URL}>LinkedIn</a>
    </span>
    <span>Shopify is a trademark of Shopify Inc. Independent contractor, not affiliated with Shopify.</span>
  </div>
</footer>
