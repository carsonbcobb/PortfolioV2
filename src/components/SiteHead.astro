---
// Meta, Open Graph, JSON-LD, and the deferred GA4 tag shared by every page's <head>.
import { GA_ID, SITE_URL, ogImageFor } from '../data/site';

export interface Props {
  title: string;
  description: string;
  keywords?: string;
  jsonLd?: object[];
  themeColor?: string;
}

const {
  title,
  description,
  keywords = 'fractional head of ecommerce, Shopify ecommerce manager, DTC ecommerce lead, Shopify retainer, white label Shopify developer',
  jsonLd = [],
  themeColor = '#FF5A5F',
} = Astro.props;

// Pages build as name.html (see astro.config.mjs), but are served and linked without the extension.
const canonical = new URL(Astro.url.pathname.replace(/(\.html|\/)$/, '') || '/', SITE_URL).href;
// Share image comes from the page path (see OG_BY_PATH in data/site.ts), so no page sets its own.
const og = ogImageFor(Astro.url.pathname);
const ogImage = new URL(og.path, SITE_URL).href;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="keywords" content={keywords} />
<meta name="author" content="Carson Cobb" />
<meta name="robots" content={Astro.url.pathname.startsWith('/404') ? 'noindex' : 'index, follow'} />
<meta name="theme-color" content={themeColor} />
<link rel="canonical" href={canonical} />
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="apple-touch-icon" href="/icon.png" />
<link rel="sitemap" href="/sitemap.xml" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content="Carson Cobb" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content={String(og.width)} />
<meta property="og:image:height" content={String(og.height)} />
<meta property="og:image:alt" content={og.alt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={og.alt} />

{jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}

<!-- Google tag (gtag.js). Commands queue in dataLayer; the library loads once the page is idle. -->
<script is:inline define:vars={{ GA_ID }}>
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    dataLayer.push(arguments);
  }
  window.gtag = gtag;
  gtag('js', new Date());
  gtag('config', GA_ID);
  window.addEventListener('load', function () {
    (window.requestIdleCallback || setTimeout)(function () {
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
      document.head.appendChild(s);
    });
  });
  // Fire GA4 events for tracked links (book_call, visibility_check, ...) and email clicks.
  document.addEventListener('click', function (e) {
    var a = e.target.closest && e.target.closest('a[data-track], a[href^="mailto:"]');
    if (!a) return;
    gtag('event', a.dataset.track ? a.dataset.track + '_click' : 'email_click', {
      link_url: a.href,
      link_text: a.textContent.trim(),
      page_path: location.pathname,
    });
  });
</script>
<script is:inline>
  // First visit source for the AI Visibility Check: referrer, landing page and UTMs, saved once.
  try {
    if (!localStorage.getItem('cc_src')) {
      var q = new URLSearchParams(location.search);
      localStorage.setItem(
        'cc_src',
        JSON.stringify({
          referrer: document.referrer || '',
          landing: location.pathname + location.search,
          utm_source: q.get('utm_source') || '',
          utm_medium: q.get('utm_medium') || '',
          utm_campaign: q.get('utm_campaign') || '',
        }),
      );
    }
  } catch (e) {}
</script>
