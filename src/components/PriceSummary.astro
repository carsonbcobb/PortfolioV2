---
// The two Close the Gap sizes, linking to /close-the-gap and /pricing, from the same data as the pricing page.
// Used on the homepage, /ai-search and as the pricing teaser on the service and industry pages.
import { PROGRAM, PROGRAM_SIZES } from '../data/site';

interface Props {
  /** Heading id, for the section's aria-labelledby */
  id: string;
  heading?: string;
  /** Light sand background (default) or white */
  sand?: boolean;
  /** No top padding, when it follows another section with the same background */
  flush?: boolean;
  /** Prices only, without the size details (the service pages' teaser) */
  compact?: boolean;
  /** One short line per card (the industry pages) */
  brief?: boolean;
  eyebrow?: string;
}

const { id, heading = 'Close the gap. Two sizes.', sand = true, flush = false, compact = false, brief = false, eyebrow = 'Pricing' } = Astro.props;
const usd = (n: number) => `$${n.toLocaleString('en-US')}`;
---

<section class:list={['section', sand && 'section--sand', flush && 'section--flush']} aria-labelledby={id}>
  <div class="wrap stack">
    <div class="head">
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="h2" id={id}>{heading}</h2>
      {!compact && !brief && <p class="lede">{PROGRAM.summary}</p>}
    </div>
    <div class="grid grid--320 price-summary price-summary--two">
      {
        PROGRAM_SIZES.map((z) => (
          <a class="card price-card" href={PROGRAM.path}>
            <span class="tag">{z.fit}</span>
            <h3 class="h3">{z.name}</h3>
            <div class="plan__price">
              <span>from</span> {usd(z.monthly)}
              <span>/month</span>
            </div>
            {brief && <p class="plan__summary">{z.items[0]}.</p>}
            {!brief && <p class="plan__summary">{z.items.join('. ')}.</p>}
          </a>
        ))
      }
    </div>
    <p class="ways__more">
      <a href={PROGRAM.path}>See the program →</a>
      <span aria-hidden="true">&nbsp;·&nbsp;</span>
      <a href="/pricing">See full pricing →</a>
    </p>
  </div>
</section>
