---
// The two Close the Gap sizes, from the same data as the pricing page. Full size cards on /ai-search;
// the same cards on the industry pages' "How we work together".
import SizeCard from './SizeCard.astro';
import { PROGRAM, PROGRAM_SIZES, CHECK_PATH, CTA_LABEL } from '../data/site';

interface Props {
  /** Heading id, for the section's aria-labelledby */
  id: string;
  heading?: string;
  /** Light sand background (default) or white */
  sand?: boolean;
  /** No top padding, when it follows another section with the same background */
  flush?: boolean;
  /** No summary line under the heading */
  compact?: boolean;
  eyebrow?: string;
}

const { id, heading = 'Close the gap. Two sizes.', sand = true, flush = false, compact = false, eyebrow = 'Pricing' } = Astro.props;
---

<section class:list={['section', sand && 'section--sand', flush && 'section--flush']} aria-labelledby={id}>
  <div class="wrap stack">
    <div class="head">
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="h2" id={id}>{heading}</h2>
      {!compact && <p class="lede">{PROGRAM.summary}</p>}
    </div>
    <div class="grid grid--320 plans">
      {PROGRAM_SIZES.map((z) => (
        <SizeCard size={z} />
      ))}
    </div>
    <div class="btn-row">
      <a href={CHECK_PATH} data-track="visibility_check" class="btn btn--accent">{CTA_LABEL}</a>
      <a href={PROGRAM.path} class="btn btn--outline">See how it works</a>
    </div>
  </div>
</section>
