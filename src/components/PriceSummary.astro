---
// The two Close the Gap sizes, from the same data as the pricing page. Full size cards on /ai-search;
// a short card per size (the industry pages' "How we work together") when brief is set.
import SizeCard from './SizeCard.astro';
import { PROGRAM, PROGRAM_SIZES, sizeOtherPrices, CHECK_PATH, CTA_LABEL } from '../data/site';

interface Props {
  /** Heading id, for the section's aria-labelledby */
  id: string;
  heading?: string;
  /** Light sand background (default) or white */
  sand?: boolean;
  /** No top padding, when it follows another section with the same background */
  flush?: boolean;
  /** No summary line under the heading */
  compact?: boolean;
  /** One short card per size (the industry pages) */
  brief?: boolean;
  eyebrow?: string;
}

const { id, heading = 'Close the gap. Two sizes.', sand = true, flush = false, compact = false, brief = false, eyebrow = 'Pricing' } = Astro.props;
const usd = (n: number) => `$${n.toLocaleString('en-US')}`;
---

<section class:list={['section', sand && 'section--sand', flush && 'section--flush']} aria-labelledby={id}>
  <div class="wrap stack">
    <div class="head">
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="h2" id={id}>{heading}</h2>
      {!compact && <p class="lede">{PROGRAM.summary}</p>}
    </div>
    {
      brief ? (
        <div class="grid grid--320 price-summary price-summary--two">
          {PROGRAM_SIZES.map((z) => (
            <a class="card price-card" href={PROGRAM.path}>
              <span class="tag">{z.fit}</span>
              <h3 class="h3">{z.name}</h3>
              <div class="plan__price">
                {usd(z.monthly)}
                <span>/month</span>
              </div>
              <p class="plan__commit">3 month commitment</p>
              <p class="plan__other">{sizeOtherPrices(z)}</p>
              <p class="plan__summary">{z.brief}</p>
            </a>
          ))}
        </div>
      ) : (
        <div class="grid grid--320 plans">
          {PROGRAM_SIZES.map((z) => (
            <SizeCard size={z} />
          ))}
        </div>
      )
    }
    <div class="btn-row">
      <a href={CHECK_PATH} data-track="visibility_check" class="btn btn--accent">{CTA_LABEL}</a>
      <a href={PROGRAM.path} class="btn btn--outline">See the program</a>
    </div>
  </div>
</section>
