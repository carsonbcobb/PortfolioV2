---
import Card from './Card.astro';

// Rendered only when SHOW_TESTIMONIALS is on in src/data/site.ts.
interface Props {
  items: { quote: string; name: string; brand: string }[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <section class="testimonials" aria-label="Testimonials">
      <div class="grid grid--2">
        {items.map((t) => (
          <Card as="article" class="testimonial">
            <span class="testimonial__mark" aria-hidden="true">“</span>
            <blockquote>{t.quote}</blockquote>
            <p class="testimonial__cite">
              <strong>{t.name}</strong>, {t.brand}
            </p>
          </Card>
        ))}
      </div>
    </section>
  )
}

<style is:global>
  .testimonials {
    padding: 0 var(--container-padding) var(--section-padding-y);
    /* Sits directly under Results, so it shares that section's background. */
    background: var(--color-bg);
  }

  .testimonial {
    margin: 0;
  }

  .testimonial__mark {
    display: block;
    height: 2.5rem;
    font-size: 4.5rem;
    font-weight: 800;
    line-height: 1;
    color: var(--color-accent);
  }

  .testimonial blockquote {
    margin: 0 0 1rem;
    font-size: 1.1rem;
    line-height: 1.7;
  }

  .testimonial__cite {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
  }

  .testimonial strong {
    color: var(--color-text);
  }
</style>
