---
// One Close the Gap size card, the only place the cards are built: the headline price with its terms, the
// included list from PROGRAM_SIZES, and Start now (the size's Stripe link) with "Get your gap report first"
// under it. Used on /close-the-gap, /pricing, /ai-search and the industry pages.
import { PROGRAM_SIZES, SIZE_TERMS, CHECK_PATH, GAP_FIRST_LABEL } from '../data/site';
import { paymentHref, type PaymentKey } from '../config/payment-links';

interface Props {
  size: (typeof PROGRAM_SIZES)[number];
  /** Hide the buttons */
  noButtons?: boolean;
  /** Heading level for the size name */
  id?: string;
}

const { size: z, noButtons = false, id } = Astro.props;
const usd = (n: number) => `$${n.toLocaleString('en-US')}`;
---

<div class:list={['card', 'plan', { 'plan--featured': z.featured }]} id={id}>
  <div class="plan__head">
    <span class:list={['tag', { 'tag--dim': z.featured }]}>{z.fit}</span>
    <h3 class="h3">{z.name}</h3>
    <p class="plan__summary">{z.tagline}</p>
    <div class="plan__price">
      {usd(z.monthly)}<span>/month</span>
    </div>
    <p class="plan__commit">{SIZE_TERMS}</p>
  </div>
  <ul class="plan__list">
    {
      z.items.map((i) => (
        <li>
          <span aria-hidden="true">✓</span>
          {i}
        </li>
      ))
    }
  </ul>
  {
    !noButtons && (
      <div class="plan__foot">
        <a href={paymentHref(z.key as PaymentKey, z.name)} data-track="start_now" class:list={['btn', z.featured ? 'btn--accent' : 'btn--outline']}>
          Start now
        </a>
        <a href={CHECK_PATH} data-track="visibility_check" class:list={['btn', 'btn--small', z.featured ? 'btn--ghost-dark' : 'btn--outline']}>
          {GAP_FIRST_LABEL}
        </a>
      </div>
    )
  }
</div>
