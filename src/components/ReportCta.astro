---
// The call to action on research reports and the /reports hub. Two variants, picked per report with the
// `cta` frontmatter field: "ai" (the default) leads with the AI Visibility Check, "cro" with the Full Store Audit.
// The compact size sits after "The short version": one line and the primary button. The full size ends the report.
// Every link carries ?from=report-{slug}, and clicks fire the GA4 event report_cta_click (see SiteHead).
export type CtaVariant = 'ai' | 'cro';

interface Props {
  variant?: CtaVariant;
  size?: 'full' | 'compact';
  /** The report's slug without "reports/", or "hub" on /reports */
  slug: string;
  position: 'short_version' | 'end' | 'hub' | 'page';
  /** Page specific copy in place of the variant's headline and body */
  headline?: string;
  body?: string;
  /** The ?from= value, when it isn't report-{slug} (pages that aren't reports) */
  from?: string;
}

const { variant = 'ai', size = 'full', slug, position, headline, body, from: fromValue } = Astro.props;

const COPY = structuredClone({
  ai: {
    eyebrow: 'AI Visibility Check',
    headline: 'Is AI recommending your competitor instead of you?',
    body: 'See who ChatGPT recommends for products like yours, and how often it picks you.',
    primary: { label: 'Run the AI Visibility Check', href: '/ai-visibility-check' },
    secondary: { label: 'Or see the Close the Gap program', href: '/close-the-gap' },
  },
  cro: {
    eyebrow: 'Full Store Audit',
    headline: 'Find the leaks costing your store sales',
    body: 'Every page on mobile and desktop, your cart, checkout, email flows and analytics, with every fix ranked by impact. Back to you in 2 business days.',
    primary: { label: 'Get the Full Store Audit', href: '/full-store-audit' },
    secondary: { label: 'Or run the AI Visibility Check', href: '/ai-visibility-check' },
  },
}[variant]);
if (headline) COPY.headline = headline;
if (body) COPY.body = body;

const from = `?from=${fromValue ?? `report-${slug}`}`;
const track = (link: 'primary' | 'secondary') => ({
  'data-track': 'report_cta',
  'data-report-slug': slug,
  'data-variant': variant,
  'data-position': position,
  'data-link': link,
});
---

<aside class:list={['report-cta-box', `report-cta-box--${size}`, position === 'hub' && 'report-cta-box--hub']} aria-label={COPY.eyebrow}>
  {
    size === 'full' ? (
      <>
        <p class="eyebrow report-cta-box__eyebrow">{COPY.eyebrow}</p>
        <p class="h3 report-cta-box__headline">{COPY.headline}</p>
        <p class="report-cta-box__body">{COPY.body}</p>
        <div class="report-cta-box__actions">
          <a class="btn btn--accent report-cta-box__button" href={COPY.primary.href + from} {...track('primary')}>
            {COPY.primary.label}
            <span aria-hidden="true">→</span>
          </a>
          <a class="report-cta-box__link" href={COPY.secondary.href + from} {...track('secondary')}>
            {COPY.secondary.label}
          </a>
        </div>
      </>
    ) : (
      <>
        <p class="report-cta-box__line">{COPY.headline}</p>
        <a class="btn btn--accent report-cta-box__button" href={COPY.primary.href + from} {...track('primary')}>
          {COPY.primary.label}
          <span aria-hidden="true">→</span>
        </a>
      </>
    )
  }
</aside>
