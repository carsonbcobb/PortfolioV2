---
// Dark top nav on every page: real pages only, plus the AI Visibility Check button.
import { NAV_LINKS, CHECK_PATH, HEADER_CTA_LABEL } from '../data/site';

const here = Astro.url.pathname.replace(/(\.html|\/)$/, '') || '/';
---

<header class="dark">
  <nav class="wrap nav" aria-label="Main">
    <a href="/" class="nav__brand">Carson Cobb</a>
    <div class="nav__links">
      {
        NAV_LINKS.map((l) => (
          <a href={l.href} aria-current={here === l.href ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
    </div>
    <a href={CHECK_PATH} data-track="visibility_check" class="btn btn--accent nav__cta">{HEADER_CTA_LABEL}</a>
  </nav>
</header>
